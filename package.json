{
  "name": "rotaractblreast",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:fresh": "rm -rf node_modules/.vite && astro dev",
    "build": "astro build && pagefind --site dist && node scripts/sync-pagefind-dev.mjs && node scripts/submit-indexnow.mjs --build",
    "preview": "astro preview",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "pagefind:sync": "node scripts/sync-pagefind-dev.mjs",
    "astro": "astro",
    "migrate": "node --env-file=.env scripts/migrate-content.mjs",
    "repair:studio": "node --env-file=.env scripts/repair-studio-data.mjs",
    "purge:orphans": "node --env-file=.env scripts/purge-orphan-assets.mjs",
    "purge:orphans:delete": "node --env-file=.env scripts/purge-orphan-assets.mjs --delete",
    "qa": "bash scripts/qa-astro.sh"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^6.0.0",
    "@sanity/astro": "^3.5.0",
    "@sanity/client": "^7.14.1",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^3.99.0",
    "astro": "^5.5.0",
    "dompurify": "^3.4.13",
    "easymde": "^2.21.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "sanity": "^6.9.1",
    "sanity-plugin-markdown": "^5.1.3",
    "sanity-plugin-media": "^3.0.5",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "pagefind": "^1.3.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "@sanity/client": "^7.14.1",
    "sanity": "$sanity"
  }
}

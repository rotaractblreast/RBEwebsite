---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Subscribe from "../components/Subscribe.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
import { SITE, PRIMARY_NAV } from "../lib/site";
import { getSiteSettings } from "../lib/content";
import {
  CONTENT_OG_IMAGE_SIZE,
  DEFAULT_OG_IMAGE_SIZE,
  metaDescription,
  twitterHandleFromUrl,
} from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  /** Accessible description of the social/OG image. Defaults to page or site title. */
  imageAlt?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  /** ISO datetime for article pages (og:article published/modified). */
  publishedTime?: string;
  modifiedTime?: string;
  canonicalPath?: string;
  jsonLd?: object | object[] | null;
  scripts?: string[];
  preloadImage?: string;
}

const {
  title,
  description = SITE.description,
  image,
  imageAlt,
  noindex = false,
  ogType = "website",
  publishedTime,
  modifiedTime,
  canonicalPath,
  jsonLd = null,
  scripts = [],
  preloadImage,
} = Astro.props;

const settings = await getSiteSettings();
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} (Easterners) - ${SITE.subtitle}`;
const path = canonicalPath ?? Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const usingDefaultOg = !image;
const ogImage = new URL(image || SITE.ogImage, SITE.url).href;
const ogSize = usingDefaultOg ? DEFAULT_OG_IMAGE_SIZE : CONTENT_OG_IMAGE_SIZE;
const ogAlt = imageAlt || title || SITE.title;
const desc = metaDescription(description);
const twitterSite = twitterHandleFromUrl(settings.siteSocial?.twitter);
const jsonBlocks = jsonLd == null ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const articleModified = modifiedTime || publishedTime;
---
<!DOCTYPE html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ff9000" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="llms-txt" href="/llms.txt" type="text/plain" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogSize.width)} />
    <meta property="og:image:height" content={String(ogSize.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && articleModified && (
      <meta property="article:modified_time" content={articleModified} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {twitterSite && <meta name="twitter:site" content={twitterSite} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="shortcut icon" href="/images/site/favicon.png" type="image/x-icon" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    {
      jsonBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header nav={[...PRIMARY_NAV]} currentPath={Astro.url.pathname} />
    <main id="main-content" class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <Subscribe />
    <Footer settings={settings} />
    <SearchOverlay />
    <button
      type="button"
      id="scroll-top"
      class="fixed bottom-6 right-6 z-40 hidden h-11 w-11 rounded-full bg-primary-container text-on-primary-container shadow-lift items-center justify-center hover:bg-primary hover:text-on-primary"
      aria-label="Scroll to top"
    >
      <span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_upward</span>
    </button>
    <script is:inline define:vars={{ gaId: SITE.gaId }}>
      document.documentElement.setAttribute("data-ga", gaId);
    </script>
    <script src="/js/site.js" defer></script>
    {scripts.map((src) => <script src={src} defer />)}
  </body>
</html>

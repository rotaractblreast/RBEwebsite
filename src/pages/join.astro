---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { getJoinFaq, getSiteSettings } from "@/lib/content";

const settings = await getSiteSettings();
const faq = await getJoinFaq();

// Empty until the Apps Script Web App is deployed - the form then stays in validate-only mode.
const formsApi = import.meta.env.PUBLIC_FORMS_API_URL ?? "";

const serviceAreas = settings.areasOfFocus.map((area) => area.title);
const clubSkills = [
  "Community service projects",
  "Event planning and hosting",
  "Design and creatives",
  "Social media and communications",
  "Professional development",
  "Fundraising",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---
<BaseLayout
  title="Join Us"
  description="Join Rotaract Club of Bangalore East. Open to young adults 18+. Connect with Easterners for leadership development, community service, and fellowship."
  jsonLd={jsonLd}
>
  <PageHero
    title="Join Us"
    eyebrow="Become an Easterner"
    lead="Connect with passionate peers, develop leadership skills, and create real community impact together."
  />
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Join" }]} />

  <section class="section-pad bg-surface-container-low">
    <div class="wrap">
      <p class="label-caps text-center mb-2">Why join</p>
      <h2 class="font-display text-headline-lg text-center mb-10">What you get as a member</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <article class="card p-6">
          <span class="material-symbols-outlined text-3xl text-primary mb-3" aria-hidden="true">diversity_3</span>
          <h3 class="font-display text-lg font-semibold mb-2">Community</h3>
          <p class="text-on-surface-variant text-sm">
            A welcoming community of Easterners offering fellowship, mentorship, and lifelong friendships.
          </p>
        </article>
        <article class="card p-6">
          <span class="material-symbols-outlined text-3xl text-primary mb-3" aria-hidden="true">school</span>
          <h3 class="font-display text-lg font-semibold mb-2">Growth</h3>
          <p class="text-on-surface-variant text-sm">
            Professional development, leadership roles, and learning by doing.
          </p>
        </article>
        <article class="card p-6">
          <span class="material-symbols-outlined text-3xl text-primary mb-3" aria-hidden="true">volunteer_activism</span>
          <h3 class="font-display text-lg font-semibold mb-2">Impact</h3>
          <p class="text-on-surface-variant text-sm">
            Hands-on service across Rotary’s areas of focus in Bangalore and beyond.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-ink text-white py-12">
    <div class="wrap flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h2 class="font-display text-2xl font-bold text-white">Ready to apply?</h2>
        <p class="text-white/80 mt-1">Fill the form below - we’ll get back to you soon.</p>
      </div>
      <a href="#application" class="btn btn-primary shrink-0">Start application</a>
    </div>
  </section>

  <section id="application" class="section-pad">
    <div class="wrap grid lg:grid-cols-5 gap-12">
      <div class="lg:col-span-3">
        <h2 class="font-display text-headline-md mb-2">Membership application</h2>
        <p class="text-sm text-on-surface-variant mb-8">
          A few questions so we can get to know you. Fields marked
          <span class="req-mark" aria-hidden="true">*</span> are required, and some questions appear
          based on your answers.
        </p>

        <div
          id="join-success"
          class="rounded-xl border border-primary-container/40 bg-primary-container/10 px-6 py-10 sm:px-8"
          role="status"
          tabindex="-1"
          hidden
        >
          <p class="label-caps text-primary mb-3">Application received</p>
          <h3 class="font-display text-headline-md mb-3">Thank you</h3>
          <p class="text-on-surface-variant mb-2" id="join-success-lead">
            We’ve got your application. Our membership team will get in touch within about a week with
            next steps - usually an invite to meet the club.
          </p>
          <p class="text-sm text-on-surface-variant mb-8">
            Check your inbox (and spam folder) for a confirmation. Questions in the meantime?
            Write to
            <a href={`mailto:${settings.email}`} class="text-primary">{settings.email}</a>.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/" class="btn btn-primary">Back to home</a>
            <a href="/events/" class="btn btn-outline">See upcoming events</a>
          </div>
        </div>

        <form id="join-form" class="space-y-10" data-api={formsApi} novalidate>
          <div aria-hidden="true" class="absolute -left-[10000px] h-px w-px overflow-hidden">
            <label for="join-website">Website</label>
            <input id="join-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="t" id="join-t" value="" />

          <fieldset class="space-y-4">
            <legend class="form-legend mb-1">Get in touch</legend>
            <div class="form-field">
              <label for="join-name">Full name <span class="req-mark" aria-hidden="true">*</span></label>
              <input id="join-name" name="name" type="text" autocomplete="name" required />
              <p class="form-error" id="join-name-error" role="alert" hidden></p>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="form-field">
                <label for="join-email">Email <span class="req-mark" aria-hidden="true">*</span></label>
                <input
                  id="join-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="you@email.com"
                  aria-describedby="join-email-hint"
                  required
                />
                <p class="form-hint" id="join-email-hint">We’ll reply here.</p>
                <p class="form-error" id="join-email-error" role="alert" hidden></p>
              </div>
              <div class="form-field">
                <label for="join-phone">Mobile number <span class="req-mark" aria-hidden="true">*</span></label>
                <input
                  id="join-phone"
                  name="phone"
                  type="tel"
                  inputmode="numeric"
                  autocomplete="tel-national"
                  pattern="[6-9][0-9]{9}"
                  placeholder="9876543210"
                  aria-describedby="join-phone-hint"
                  required
                />
                <p class="form-hint" id="join-phone-hint">10-digit Indian mobile, digits only.</p>
                <p class="form-error" id="join-phone-error" role="alert" hidden></p>
              </div>
            </div>
          </fieldset>

          <fieldset class="space-y-4">
            <legend class="form-legend mb-1">What you do</legend>
            <fieldset class="min-w-0 space-y-2">
              <legend class="form-question mb-2">
                Are you studying or working right now?
                <span class="req-mark" aria-hidden="true">*</span>
              </legend>
              <div class="choice-grid" id="join-occupation-grid">
                <label class="choice-card">
                  <input
                    class="choice-card__input"
                    type="radio"
                    name="occupation"
                    value="student"
                    required
                  />
                  <span class="choice-card__dot" aria-hidden="true"></span>
                  <span class="choice-card__body">
                    <span class="choice-card__title">Student</span>
                    <span class="choice-card__desc">I’m in college or university.</span>
                  </span>
                </label>
                <label class="choice-card">
                  <input
                    class="choice-card__input"
                    type="radio"
                    name="occupation"
                    value="professional"
                  />
                  <span class="choice-card__dot" aria-hidden="true"></span>
                  <span class="choice-card__body">
                    <span class="choice-card__title">Working professional</span>
                    <span class="choice-card__desc">I’m employed or working full-time.</span>
                  </span>
                </label>
              </div>
              <p class="form-error" id="join-occupation-error" role="alert" hidden></p>
            </fieldset>

            <div id="join-org-wrap" class="form-reveal" hidden>
              <div class="form-field">
                <label for="join-organization" id="join-organization-label">
                  College / university <span class="req-mark" aria-hidden="true">*</span>
                </label>
                <input
                  id="join-organization"
                  name="organization"
                  type="text"
                  autocomplete="organization"
                />
                <p class="form-error" id="join-organization-error" role="alert" hidden></p>
              </div>
            </div>
          </fieldset>

          <fieldset class="space-y-4">
            <legend class="form-legend mb-1">A bit about you</legend>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="form-field">
                <label for="join-dob">Date of birth <span class="req-mark" aria-hidden="true">*</span></label>
                <input id="join-dob" name="dob" type="date" aria-describedby="join-dob-hint" required />
                <p class="form-hint" id="join-dob-hint">
                  Only to confirm Rotaract age eligibility (18+).
                </p>
                <p class="form-error" id="join-dob-error" role="alert" hidden></p>
              </div>
              <div class="form-field">
                <label for="join-address">
                  Area / locality <span class="req-mark" aria-hidden="true">*</span>
                </label>
                <input
                  id="join-address"
                  name="address"
                  type="text"
                  autocomplete="address-level3"
                  placeholder="Your area in Bangalore"
                  aria-describedby="join-address-hint"
                  required
                />
                <p class="form-hint" id="join-address-hint">
                  e.g. Indiranagar, Whitefield, Jayanagar. We ask for your full address only after
                  you join.
                </p>
                <p class="form-error" id="join-address-error" role="alert" hidden></p>
              </div>
            </div>

            <fieldset class="min-w-0">
              <legend class="form-question mb-2">
                Gender <span class="font-normal text-on-surface-variant">(optional)</span>
              </legend>
              <div class="choice-grid choice-grid--compact">
                {
                  ["Male", "Female", "Non-binary", "Prefer not to say"].map((option) => (
                    <label class="choice-card choice-card--compact">
                      <input class="choice-card__input" type="radio" name="gender" value={option} />
                      <span class="choice-card__dot" aria-hidden="true" />
                      <span class="choice-card__title">{option}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <div class="form-field">
              <label for="join-social">Instagram or LinkedIn</label>
              <input
                id="join-social"
                name="social"
                type="text"
                placeholder="Profile link or @handle"
                aria-describedby="join-social-hint"
              />
              <p class="form-hint" id="join-social-hint">Optional - helps us say hello.</p>
            </div>
          </fieldset>

          <fieldset class="space-y-4">
            <legend class="form-legend mb-1">Your Rotaract story</legend>
            <fieldset class="min-w-0 space-y-2">
              <legend class="form-question mb-2">
                Have you been part of a Rotaract club before?
                <span class="req-mark" aria-hidden="true">*</span>
              </legend>
              <div class="choice-grid" id="join-rotaract-grid">
                <label class="choice-card">
                  <input
                    class="choice-card__input"
                    type="radio"
                    name="rotaractStatus"
                    value="new"
                    required
                  />
                  <span class="choice-card__dot" aria-hidden="true"></span>
                  <span class="choice-card__body">
                    <span class="choice-card__title">I’m new to Rotaract</span>
                    <span class="choice-card__desc">I haven’t been a member before.</span>
                  </span>
                </label>
                <label class="choice-card">
                  <input
                    class="choice-card__input"
                    type="radio"
                    name="rotaractStatus"
                    value="experienced"
                  />
                  <span class="choice-card__dot" aria-hidden="true"></span>
                  <span class="choice-card__body">
                    <span class="choice-card__title">I’ve been a Rotaractor</span>
                    <span class="choice-card__desc">I’m in a club now, or I was earlier.</span>
                  </span>
                </label>
              </div>
              <p class="form-error" id="join-rotaract-error" role="alert" hidden></p>
            </fieldset>

            <div id="join-branch-new" class="form-reveal" hidden>
              <div class="form-field">
                <label for="join-why">
                  Why do you want to join us? <span class="req-mark" aria-hidden="true">*</span>
                </label>
                <textarea
                  id="join-why"
                  name="why"
                  rows="3"
                  placeholder="Tell us what motivates you to be part of Rotaract Bangalore East..."
                  aria-describedby="join-why-hint"
                ></textarea>
                <p class="form-hint" id="join-why-hint">
                  A few lines is plenty - what draws you to Rotaract Bangalore East?
                </p>
                <p class="form-error" id="join-why-error" role="alert" hidden></p>
              </div>
            </div>

            <div id="join-branch-experienced" class="form-reveal space-y-4" hidden>
              <div class="form-field">
                <label for="join-club">
                  Current or most recent club <span class="req-mark" aria-hidden="true">*</span>
                </label>
                <input id="join-club" name="clubName" type="text" placeholder="Club name" />
                <p class="form-error" id="join-club-error" role="alert" hidden></p>
              </div>
              <div class="form-field">
                <label for="join-journey">
                  Share a brief about your Rotaract journey
                  <span class="req-mark" aria-hidden="true">*</span>
                </label>
                <textarea
                  id="join-journey"
                  name="journey"
                  rows="3"
                  placeholder="Your previous club, roles, key projects, or what you enjoyed..."
                  aria-describedby="join-journey-hint"
                ></textarea>
                <p class="form-hint" id="join-journey-hint">
                  Projects, roles, or what you enjoyed - short is fine.
                </p>
                <p class="form-error" id="join-journey-error" role="alert" hidden></p>
              </div>
            </div>
          </fieldset>

          <fieldset class="space-y-4">
            <legend class="form-legend mb-1">Interests &amp; contribution</legend>
            <div class="form-field">
              <label for="join-hobbies">
                What are your hobbies and interests?
                <span class="req-mark" aria-hidden="true">*</span>
              </label>
              <textarea
                id="join-hobbies"
                name="hobbies"
                rows="3"
                placeholder="Reading, photography, hiking, sports, coding, volunteering..."
                required
              ></textarea>
              <p class="form-error" id="join-hobbies-error" role="alert" hidden></p>
            </div>
            <fieldset class="min-w-0 space-y-3" id="join-contribute-group">
              <legend class="form-question mb-1">
                Where would you like to help?
                <span class="req-mark" aria-hidden="true">*</span>
              </legend>
              <p class="form-hint -mt-1">
                Pick as many as you like. Nothing here is binding - it just helps us point you at
                the right projects.
              </p>

              <p class="check-subhead" id="join-contribute-service">Causes</p>
              <div class="check-grid" aria-labelledby="join-contribute-service">
                {
                  serviceAreas.map((area) => (
                    <label class="check-card">
                      <input class="check-card__input" type="checkbox" name="contribute" value={area} />
                      <span class="check-card__box" aria-hidden="true">
                        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M2 6.5 4.75 9 10 3.5" />
                        </svg>
                      </span>
                      <span>{area}</span>
                    </label>
                  ))
                }
              </div>

              <p class="check-subhead pt-1" id="join-contribute-skills">Ways to pitch in</p>
              <div class="check-grid" aria-labelledby="join-contribute-skills">
                {
                  clubSkills.map((skill) => (
                    <label class="check-card">
                      <input class="check-card__input" type="checkbox" name="contribute" value={skill} />
                      <span class="check-card__box" aria-hidden="true">
                        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M2 6.5 4.75 9 10 3.5" />
                        </svg>
                      </span>
                      <span>{skill}</span>
                    </label>
                  ))
                }
                <label class="check-card">
                  <input
                    class="check-card__input"
                    type="checkbox"
                    name="contribute"
                    value="Other"
                    id="join-contribute-other-toggle"
                  />
                  <span class="check-card__box" aria-hidden="true">
                    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 6.5 4.75 9 10 3.5" />
                    </svg>
                  </span>
                  <span>Something else</span>
                </label>
              </div>

              <div id="join-contribute-other-wrap" class="form-reveal" hidden>
                <div class="form-field">
                  <label for="join-contribute-other">
                    Tell us what you have in mind <span class="req-mark" aria-hidden="true">*</span>
                  </label>
                  <textarea
                    id="join-contribute-other"
                    name="contributeOther"
                    rows="2"
                    placeholder="Tell us what you have in mind..."
                  ></textarea>
                  <p class="form-error" id="join-contribute-other-error" role="alert" hidden></p>
                </div>
              </div>

              <p class="form-error" id="join-contribute-error" role="alert" hidden></p>
            </fieldset>
          </fieldset>

          <div class="space-y-4 border-t border-outline-variant/40 pt-6">
            <div class="form-summary" id="join-summary" role="alert" tabindex="-1" hidden>
              <p class="font-semibold">Please check the highlighted fields.</p>
              <ul class="mt-1 list-disc space-y-0.5 pl-5" id="join-summary-list"></ul>
            </div>

            <button type="submit" class="btn btn-primary w-full sm:w-auto" id="join-submit">
              Submit application
            </button>

            <div class="text-sm text-on-surface-variant space-y-1">
              <p class="font-semibold text-on-surface">What happens next</p>
              <p>
Our membership team reads every application and gets in touch, usually within a
                  week.
              </p>
              <p>
                Your answers go to the Rotaract Bangalore East membership team only. See our
                <a href="/privacy/" class="text-primary">Privacy Policy</a>.
              </p>
            </div>

            <p
              id="join-status"
              class="text-sm font-medium text-primary"
              role="status"
              tabindex="-1"
              hidden
            >
            </p>
          </div>
        </form>
      </div>
      <aside class="lg:col-span-2 space-y-6">
        <div class="card p-6 bg-surface-container-low">
          <h3 class="font-display font-semibold mb-3">Contact</h3>
          <p class="text-sm text-on-surface-variant mb-1">{settings.location}</p>
          <p class="text-sm">
            <a href={`mailto:${settings.email}`} class="text-primary">{settings.email}</a>
          </p>
          <p class="text-sm">
            <a href={`tel:${settings.phone.replace(/\s/g, "")}`} class="text-primary"
              >{settings.phone}</a
            >
          </p>
        </div>
        {
          faq.length > 0 && (
            <div class="card p-6">
              <h3 class="font-display font-semibold mb-4">FAQ</h3>
              {faq.map((item, i) => (
                <details
                  class:list={[
                    "py-3",
                    i < faq.length - 1 && "border-b border-outline-variant/40",
                  ]}
                >
                  <summary class="font-medium cursor-pointer">{item.question}</summary>
                  <p class="text-sm text-on-surface-variant mt-2">{item.answer}</p>
                </details>
              ))}
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById("join-form");
      if (!form) return;

      var byId = function (id) {
        return document.getElementById(id);
      };

      var orgWrap = byId("join-org-wrap");
      var orgInput = byId("join-organization");
      var orgLabel = byId("join-organization-label");
      var branchNew = byId("join-branch-new");
      var branchExp = byId("join-branch-experienced");
      var summary = byId("join-summary");
      var summaryList = byId("join-summary-list");
      var statusNote = byId("join-status");
      var submitBtn = byId("join-submit");
      var successPanel = byId("join-success");
      var successLead = byId("join-success-lead");
      var stamp = byId("join-t");

      var why = byId("join-why");
      var club = byId("join-club");
      var journey = byId("join-journey");
      var hobbies = byId("join-hobbies");
      var otherToggle = byId("join-contribute-other-toggle");
      var otherWrap = byId("join-contribute-other-wrap");
      var otherInput = byId("join-contribute-other");
      var contributeGroup = byId("join-contribute-group");
      var contributeError = byId("join-contribute-error");

      function setupAutoExpand(el) {
        if (!el) return function () {};
        function adjust() {
          if (!el.offsetParent && el.scrollHeight === 0) return;
          el.style.height = "auto";
          var scrollH = el.scrollHeight;
          if (scrollH > 0) {
            if (scrollH > 480) {
              el.style.height = "480px";
              el.style.overflowY = "auto";
            } else {
              el.style.height = scrollH + "px";
              el.style.overflowY = "hidden";
            }
          }
        }
        el.addEventListener("input", adjust);
        el.addEventListener("focus", adjust);
        el.addEventListener("change", adjust);
        adjust();
        return adjust;
      }

      var adjustWhy = setupAutoExpand(why);
      var adjustJourney = setupAutoExpand(journey);
      var adjustHobbies = setupAutoExpand(hobbies);
      var adjustOther = setupAutoExpand(otherInput);

      if (stamp) stamp.value = String(Date.now());

      // Capping the date at "18 years ago" also makes the native calendar open on a
      // plausible year instead of today, so nobody has to page back two decades.
      var dob = byId("join-dob");
      if (dob) {
        var now = new Date();
        var cap = new Date(now.getFullYear() - 18, now.getMonth(), now.getDate());
        var mm = cap.getMonth() + 1;
        var dd = cap.getDate();
        dob.max = cap.getFullYear() + "-" + (mm < 10 ? "0" + mm : mm) + "-" + (dd < 10 ? "0" + dd : dd);
      }

      var FIELDS = [
        { el: byId("join-name"), error: "join-name-error", label: "Full name", missing: "Enter your full name." },
        {
          el: byId("join-email"),
          error: "join-email-error",
          label: "Email",
          missing: "Enter your email address.",
          invalid: "Enter a valid email address.",
        },
        {
          el: byId("join-phone"),
          error: "join-phone-error",
          label: "Mobile number",
          missing: "Enter your mobile number.",
          invalid: "Enter a 10-digit number starting with 6-9.",
        },
        {
          el: orgInput,
          error: "join-organization-error",
          label: "College or company",
          missing: "Enter where you study or work.",
        },
        {
          el: byId("join-dob"),
          error: "join-dob-error",
          label: "Date of birth",
          missing: "Enter your date of birth.",
          invalid: "You need to be 18 or older to join Rotaract.",
        },
        {
          el: byId("join-address"),
          error: "join-address-error",
          label: "Area / locality",
          missing: "Enter your area in Bangalore.",
        },
        { el: why, error: "join-why-error", label: "Why you want to join", missing: "Tell us why you’d like to join." },
        { el: club, error: "join-club-error", label: "Current or most recent club", missing: "Enter the club name." },
        {
          el: journey,
          error: "join-journey-error",
          label: "Rotaract journey",
          missing: "Share a brief about your journey.",
        },
        {
          el: byId("join-hobbies"),
          error: "join-hobbies-error",
          label: "Hobbies and interests",
          missing: "Tell us what you’re into.",
        },
        {
          el: byId("join-contribute-other"),
          error: "join-contribute-other-error",
          label: "Something else",
          missing: "Tell us what you have in mind.",
        },
      ];

      var GROUPS = [
        {
          name: "occupation",
          grid: byId("join-occupation-grid"),
          error: "join-occupation-error",
          label: "Studying or working",
        },
        {
          name: "rotaractStatus",
          grid: byId("join-rotaract-grid"),
          error: "join-rotaract-error",
          label: "Rotaract background",
        },
      ];

      function show(el, on) {
        if (el) el.hidden = !on;
      }

      function setRequired(el, on) {
        if (el) el.required = on;
      }

      function picked(name) {
        var el = form.querySelector('input[name="' + name + '"]:checked');
        return el ? el.value : "";
      }

      function clearError(field) {
        if (!field.el) return;
        var node = byId(field.error);
        field.el.removeAttribute("aria-invalid");
        if (field.el.parentElement) field.el.parentElement.classList.remove("form-field--error");
        if (node) {
          node.hidden = true;
          node.textContent = "";
        }
      }

      function showError(field, message) {
        if (!field.el) return;
        var node = byId(field.error);
        field.el.setAttribute("aria-invalid", "true");
        if (field.el.parentElement) field.el.parentElement.classList.add("form-field--error");
        if (node) {
          node.textContent = message;
          node.hidden = false;
        }
      }

      function messageFor(field) {
        if (field.el.validity.valueMissing) return field.missing || "This field is required.";
        return field.invalid || "Check this field.";
      }

      function clearGroupError(group) {
        var node = byId(group.error);
        if (group.grid) group.grid.classList.remove("choice-grid--error");
        if (node) {
          node.hidden = true;
          node.textContent = "";
        }
      }

      function visible(el) {
        return Boolean(el && el.offsetParent !== null);
      }

      function sync() {
        var occ = picked("occupation");
        var status = picked("rotaractStatus");

        var hasOcc = occ === "student" || occ === "professional";
        show(orgWrap, hasOcc);
        setRequired(orgInput, hasOcc);
        if (orgLabel) {
          orgLabel.innerHTML =
            (occ === "professional" ? "Company / organisation" : "College / university") +
            ' <span class="req-mark" aria-hidden="true">*</span>';
        }
        if (!hasOcc && orgInput) orgInput.value = "";

        var isNew = status === "new";
        var isExp = status === "experienced";
        show(branchNew, isNew);
        show(branchExp, isExp);
        setRequired(why, isNew);
        setRequired(club, isExp);
        setRequired(journey, isExp);

        if (!isNew && why) why.value = "";
        if (!isExp) {
          if (club) club.value = "";
          if (journey) journey.value = "";
        }

        var wantsOther = Boolean(otherToggle && otherToggle.checked);
        show(otherWrap, wantsOther);
        setRequired(otherInput, wantsOther);
        if (!wantsOther && otherInput) otherInput.value = "";

        if (isNew) adjustWhy();
        if (isExp) adjustJourney();
        if (wantsOther) adjustOther();
      }

      function contributeCount() {
        return form.querySelectorAll('input[name="contribute"]:checked').length;
      }

      function clearContributeError() {
        if (contributeGroup) {
          contributeGroup.querySelectorAll(".check-grid").forEach(function (grid) {
            grid.classList.remove("check-grid--error");
          });
        }
        if (contributeError) {
          contributeError.hidden = true;
          contributeError.textContent = "";
        }
      }

      function validate() {
        var problems = [];

        FIELDS.forEach(function (field) {
          clearError(field);
          if (!field.el || !field.el.required || !visible(field.el)) return;
          if (!field.el.checkValidity()) {
            var msg = messageFor(field);
            showError(field, msg);
            problems.push({ text: msg, el: field.el });
          }
        });

        GROUPS.forEach(function (group) {
          clearGroupError(group);
          if (picked(group.name)) return;
          var node = byId(group.error);
          if (group.grid) group.grid.classList.add("choice-grid--error");
          if (node) {
            node.textContent = "Choose an option.";
            node.hidden = false;
          }
          problems.push({
            text: group.label + " - choose an option.",
            el: form.querySelector('input[name="' + group.name + '"]'),
          });
        });

        clearContributeError();
        if (!contributeCount()) {
          if (contributeGroup) {
            contributeGroup.querySelectorAll(".check-grid").forEach(function (grid) {
              grid.classList.add("check-grid--error");
            });
          }
          if (contributeError) {
            contributeError.textContent = "Pick at least one.";
            contributeError.hidden = false;
          }
          problems.push({
            text: "Where you’d like to help - pick at least one.",
            el: form.querySelector('input[name="contribute"]'),
          });
        }

        return problems;
      }

      form.addEventListener("change", function (e) {
        var t = e.target;
        if (!t) return;
        if (t.name === "occupation" || t.name === "rotaractStatus") {
          sync();
          GROUPS.forEach(function (group) {
            if (group.name === t.name) clearGroupError(group);
          });
        }
        if (t.name === "contribute") {
          sync();
          if (contributeCount()) clearContributeError();
        }
      });

      // Once a field has been flagged, re-check it as the applicant types.
      form.addEventListener("input", function (e) {
        FIELDS.forEach(function (field) {
          if (field.el !== e.target) return;
          if (!field.el.hasAttribute("aria-invalid")) return;
          if (field.el.checkValidity()) clearError(field);
        });
      });

      function setStatus(text, isError) {
        if (!statusNote) return;
        statusNote.textContent = text;
        statusNote.className = "text-sm font-medium " + (isError ? "text-error" : "text-primary");
        statusNote.hidden = false;
        statusNote.focus();
      }

      function showThankYou(email, preview) {
        if (successLead) {
          if (preview) {
            successLead.textContent =
              "Preview only - nothing was sent. This is the thank-you state applicants will see after a successful Apps Script response.";
          } else if (email) {
            successLead.textContent =
              "We’ve got your application and emailed a confirmation to " +
              email +
              ". Our membership team will get in touch within about a week - usually with an invite to meet the club.";
          }
        }
        if (form) form.hidden = true;
        if (successPanel) {
          successPanel.hidden = false;
          successPanel.focus();
          successPanel.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }

      function readJson(res) {
        // Apps Script always returns a 200 transport status with a JSON body; the body
        // carries the real signal (`ok` + `status`). Defend against empty/HTML replies.
        return res.text().then(function (raw) {
          try {
            return JSON.parse(raw);
          } catch (err) {
            throw new Error("Unexpected response from the server.");
          }
        });
      }

      function isSuccess(res) {
        return Boolean(res && res.ok === true && Number(res.status) === 200);
      }

      function failMessage(res) {
        if (res && res.error) return String(res.error);
        if (res && res.status === 429) return "Too many submissions. Try again in a few minutes.";
        if (res && res.status === 403) return "Request blocked. Reload the page and try again.";
        return "Something went wrong.";
      }

      function payload() {
        var data = {
          form: "join",
          name: byId("join-name").value,
          email: byId("join-email").value,
          phone: byId("join-phone").value,
          dob: byId("join-dob").value,
          gender: picked("gender"),
          address: byId("join-address").value,
          social: byId("join-social").value,
          organizationType: picked("occupation"),
          organization: orgInput ? orgInput.value : "",
          rotaractStatus: picked("rotaractStatus"),
          why: why ? why.value : "",
          clubName: club ? club.value : "",
          journey: journey ? journey.value : "",
          hobbies: byId("join-hobbies").value,
          contribute: [],
          contributeOther: otherInput ? otherInput.value : "",
          website: byId("join-website").value,
          t: Number(stamp && stamp.value) || 0,
        };
        form.querySelectorAll('input[name="contribute"]:checked').forEach(function (box) {
          data.contribute.push(box.value);
        });
        return data;
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        sync();

        if (statusNote) statusNote.hidden = true;
        var problems = validate();

        if (problems.length) {
          if (summaryList) {
            summaryList.innerHTML = "";
            problems.forEach(function (p) {
              var li = document.createElement("li");
              li.textContent = p.text;
              summaryList.appendChild(li);
            });
          }
          show(summary, true);
          if (summary) summary.focus();
          return;
        }

        show(summary, false);

        var apiUrl = form.getAttribute("data-api") || "";
        if (!apiUrl) {
          // No Web App URL yet - show the thank-you panel so we can review it, clearly marked.
          showThankYou(byId("join-email").value, true);
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";

        var body = payload();

        // text/plain keeps this a simple request, so the browser skips the CORS preflight
        // that Apps Script web apps cannot answer.
        fetch(apiUrl, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(body),
          redirect: "follow",
        })
          .then(readJson)
          .then(function (res) {
            // Authoritative success is the JSON body from Code.gs - not the HTTP code.
            if (!isSuccess(res)) throw new Error(failMessage(res));
            showThankYou(body.email, false);
          })
          .catch(function (err) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Submit application";
            setStatus(
              "We couldn’t send your application (" +
                err.message +
                "). Please try again, or email us at info@rotaractblreast.org.",
              true
            );
          });
      });

      sync();
    })();
  </script>
</BaseLayout>

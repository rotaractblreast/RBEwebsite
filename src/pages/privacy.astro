---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import privacyHtml from "@/content/privacy.html?raw";
---
<BaseLayout
  title="Privacy Policy"
  description="Privacy Policy for rotaractblreast.org - what data we collect, how it is stored, third-party services used, and your rights under India's DPDPA and GDPR when visiting the Rotaract Bangalore East website."
>
  <PageHero title="Privacy Policy" />
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Privacy" }]} />
  <section class="section-pad">
    <div class="wrap prose-rbe" set:html={privacyHtml} />
  </section>
</BaseLayout>

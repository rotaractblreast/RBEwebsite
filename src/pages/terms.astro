---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import termsHtml from "@/content/terms.html?raw";
---
<BaseLayout
  title="Terms of Service"
  description="Terms of Service for rotaractblreast.org - acceptable use, membership applications, intellectual property, governing law (Karnataka, India), and your rights when using the Rotaract Bangalore East website."
>
  <PageHero title="Terms of Service" />
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Terms" }]} />
  <section class="section-pad">
    <div class="wrap prose-rbe" set:html={termsHtml} />
  </section>
</BaseLayout>

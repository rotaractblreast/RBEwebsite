---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import MarkdownBody from "@/components/MarkdownBody.astro";
import Share from "@/components/Share.astro";
import { getEvents } from "@/lib/content";
import { formatDateTime, toUnix } from "@/lib/events";
import { breadcrumbListJsonLd, eventJsonLd } from "@/lib/seo";

export async function getStaticPaths() {
  const events = await getEvents();
  return events
    .filter((event) => !/^page-\d+$/i.test(event.slug))
    .map((event) => ({
      params: { slug: event.slug },
      props: { event },
    }));
}

const { event } = Astro.props;
const buttonHref = event.buttonUrl?.includes("://")
  ? event.buttonUrl
  : event.buttonUrl
    ? event.buttonUrl.startsWith("/")
      ? event.buttonUrl
      : `/${event.buttonUrl}`
    : "";

const datePart = event.start ? ` on ${formatDateTime(event.start)}` : "";
const venuePart = event.venue ? ` at ${event.venue}` : "";
const fallbackSummary = `${event.title} hosted by Rotaract Bangalore East${datePart}${venuePart}. Join Easterners for community service and fellowship.`;
const summary = (event.description || event.intro || fallbackSummary).trim();
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Events", href: "/events/" },
  { label: event.title },
];
const jsonLd = [
  eventJsonLd({
    title: event.title,
    description: summary,
    url: event.url,
    start: event.start,
    end: event.end,
    venue: event.venue,
    image: event.image,
  }),
  breadcrumbListJsonLd(crumbs),
];
---
<BaseLayout
  title={event.title}
  description={summary}
  image={event.image}
  imageAlt={event.title}
  canonicalPath={event.url}
  jsonLd={jsonLd}
>
  <PageHero title={event.title} eyebrow="Event" background={false} />
  <Breadcrumbs crumbs={crumbs} />
  <article class="section-pad pt-0">
    <div class="wrap grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        {
          event.image && (
            <img
              src={event.image}
              alt={event.title}
              class="w-full rounded-lg mb-8 aspect-[16/9] object-cover"
              fetchpriority="high"
              decoding="async"
              width="1200"
              height="675"
            />
          )
        }
        {event.intro && <p class="text-body-lg text-on-surface-variant mb-6">{event.intro}</p>}
        <MarkdownBody markdown={event.bodyMarkdown || event.description} />
        <Share url={event.url} title={event.title} />
      </div>
      <aside class="lg:col-span-1">
        <div class="card p-6 sticky-panel space-y-4">
          <div>
            <p class="label-caps mb-1">Starts</p>
            <p class="font-medium">{formatDateTime(event.start)}</p>
          </div>
          {
            event.end && (
              <div>
                <p class="label-caps mb-1">Ends</p>
                <p class="font-medium">{formatDateTime(event.end)}</p>
              </div>
            )
          }
          {
            event.venue && (
              <div>
                <p class="label-caps mb-1">Venue</p>
                <p class="font-medium">{event.venue}</p>
              </div>
            )
          }
          {
            event.buttonOpen && event.buttonUrl ? (
              <a
                href={buttonHref}
                class="btn btn-primary w-full"
                target="_blank"
                rel="noopener"
                data-event-rsvp
                data-end={toUnix(event.end ?? event.start) ?? 0}
              >
                {event.buttonText || "RSVP"}
              </a>
            ) : (
              <span class="btn btn-outline w-full opacity-60 cursor-not-allowed">Closed</span>
            )
          }
        </div>
      </aside>
    </div>
  </article>

  <script is:inline>
    (() => {
      const rsvp = document.querySelector("[data-event-rsvp]");
      if (rsvp) {
        const end = Number(rsvp.getAttribute("data-end"));
        if (end && end < Math.floor(Date.now() / 1000)) {
          const closed = document.createElement("span");
          closed.className = "btn btn-outline w-full opacity-60 cursor-not-allowed";
          closed.textContent = "Event Concluded";
          rsvp.replaceWith(closed);
        }
      }
    })();
  </script>
</BaseLayout>

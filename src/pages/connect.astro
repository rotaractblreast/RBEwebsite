          if (notes.length === 0) {
            modalNotesList.innerHTML =
              '<div class="text-center py-6 text-xs text-stone-400 italic bg-white rounded-xl border border-stone-200/80">No reviewer remarks logged yet. Add observations below.</div>';
            return;
          }

          notes.forEach((n) => {
            const card = document.createElement("div");

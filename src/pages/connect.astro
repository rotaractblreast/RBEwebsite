        // Custom Accessible Styled Select Component
        function createCustomSelect({ container, defaultValue, options, onChange, direction = "down" }) {
          if (!container) return null;
          let selectedValue = defaultValue || (options[0] ? options[0].value : "");
          let isOpen = false;

          container.innerHTML = "";
          container.classList.add("relative", "select-none");

          // Trigger Button
          const button = document.createElement("button");
          button.type = "button";
          button.className =
            "w-full flex items-center justify-between px-3.5 py-2.5 bg-white hover:bg-stone-50/90 border border-stone-300 hover:border-stone-400 rounded-xl text-stone-900 text-sm font-medium focus:outline-none focus:border-[#ff9000] focus:ring-2 focus:ring-[#ff9000]/20 shadow-2xs transition-all cursor-pointer";
          button.setAttribute("aria-haspopup", "listbox");
          button.setAttribute("aria-expanded", "false");

          const leftWrap = document.createElement("div");
          leftWrap.className = "flex items-center gap-2.5 min-w-0 truncate";

          const dotEl = document.createElement("span");
          dotEl.className = "h-2.5 w-2.5 rounded-full shrink-0 hidden";

          const labelEl = document.createElement("span");
          labelEl.className = "truncate text-stone-900 font-semibold";

          leftWrap.appendChild(dotEl);
          leftWrap.appendChild(labelEl);

          const chevron = document.createElement("span");
          chevron.className =
            "material-symbols-outlined text-stone-400 text-xl transition-transform duration-200 pointer-events-none shrink-0 ml-2";
          chevron.textContent = direction === "up" ? "keyboard_arrow_up" : "expand_more";

          button.appendChild(leftWrap);
          button.appendChild(chevron);

          // Floating Dropdown Menu
          const menu = document.createElement("div");
          if (direction === "up") {
            menu.className =
              "absolute left-0 bottom-full mb-2 z-50 bg-white border border-stone-200/90 rounded-2xl shadow-2xl p-1.5 max-h-72 overflow-y-auto hidden w-full sm:min-w-[280px]";
          } else {
            menu.className =
              "absolute left-0 right-0 top-full mt-1.5 z-40 bg-white border border-stone-200/90 rounded-xl shadow-xl p-1.5 max-h-60 overflow-y-auto hidden";
          }
          menu.setAttribute("role", "listbox");

          function updateDisplay() {
            const opt = options.find((o) => o.value === selectedValue) || options[0];
            if (opt) {
              labelEl.textContent = opt.label;
              if (opt.dot) {
                dotEl.className = "h-2.5 w-2.5 rounded-full shrink-0 " + opt.dot;
                dotEl.classList.remove("hidden");
              } else {
                dotEl.classList.add("hidden");
              }
            }
            const allItems = menu.querySelectorAll("[role='option']");
            allItems.forEach((itemEl) => {
              const val = itemEl.getAttribute("data-value");
              const isSelected = val === selectedValue;
              const chk = itemEl.querySelector(".item-check");
              if (isSelected) {
                itemEl.classList.add("bg-amber-50/90", "text-[#8e4e00]");
                itemEl.classList.remove("text-stone-700", "hover:bg-stone-50");
                itemEl.setAttribute("aria-selected", "true");
                if (chk) chk.classList.remove("hidden");
              } else {
                itemEl.classList.remove("bg-amber-50/90", "text-[#8e4e00]");
                itemEl.classList.add("text-stone-700", "hover:bg-stone-50");
                itemEl.setAttribute("aria-selected", "false");
                if (chk) chk.classList.add("hidden");
              }
            });
          }

          options.forEach((opt) => {
            const item = document.createElement("button");
            item.type = "button";
            item.setAttribute("role", "option");
            item.setAttribute("data-value", opt.value);
            item.className =
              "w-full text-left px-3 py-2 text-xs sm:text-sm font-medium text-stone-700 hover:bg-stone-50 hover:text-stone-950 flex items-center justify-between cursor-pointer transition-colors rounded-xl";

            const itemLeft = document.createElement("div");
            itemLeft.className = "flex items-center gap-2.5 min-w-0";

            if (opt.dot) {
              const itemDot = document.createElement("span");
              itemDot.className = "h-2.5 w-2.5 rounded-full shrink-0 " + opt.dot;
              itemLeft.appendChild(itemDot);
            }

            const textWrap = document.createElement("div");
            textWrap.className = "min-w-0 flex flex-col";

            const itemText = document.createElement("span");
            itemText.className = "font-semibold text-stone-900 whitespace-nowrap leading-snug";
            itemText.textContent = opt.label;
            textWrap.appendChild(itemText);

            if (opt.desc) {
              const itemDesc = document.createElement("span");
              itemDesc.className = "text-[11px] text-stone-400 font-normal leading-tight whitespace-nowrap";
              itemDesc.textContent = opt.desc;
              textWrap.appendChild(itemDesc);
            }

            itemLeft.appendChild(textWrap);

            const checkIcon = document.createElement("span");
            checkIcon.className =
              "material-symbols-outlined text-base text-[#ff9000] shrink-0 item-check hidden ml-3";
            checkIcon.textContent = "check";

            item.appendChild(itemLeft);
            item.appendChild(checkIcon);

            item.addEventListener("click", (e) => {
              e.stopPropagation();
              selectedValue = opt.value;
              updateDisplay();
              closeMenu();
              if (typeof onChange === "function") {
                onChange(selectedValue);
              }
            });

            menu.appendChild(item);
          });

          function openMenu() {
            // Close any other open custom dropdowns
            document.querySelectorAll(".custom-select-menu").forEach((m) => {
              if (m !== menu) {
                m.classList.add("hidden");
                const pBtn = m.previousElementSibling;
                if (pBtn) {
                  pBtn.setAttribute("aria-expanded", "false");
                  const ic = pBtn.querySelector(".material-symbols-outlined:last-child");
                  if (ic) ic.classList.remove("rotate-180");
                }
              }
            });

            menu.classList.remove("hidden");
            chevron.classList.add("rotate-180");
            button.setAttribute("aria-expanded", "true");
            isOpen = true;
          }

          function closeMenu() {
            menu.classList.add("hidden");
            chevron.classList.remove("rotate-180");
            button.setAttribute("aria-expanded", "false");
            isOpen = false;
          }

          button.addEventListener("click", (e) => {
            e.stopPropagation();
            if (isOpen) {
              closeMenu();
            } else {
              openMenu();
            }
          });

          document.addEventListener("click", (e) => {
            if (!container.contains(e.target) && isOpen) {
              closeMenu();
            }
          });

          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && isOpen) {
              closeMenu();
            }
          });

          menu.classList.add("custom-select-menu");
          container.appendChild(button);
          container.appendChild(menu);

          updateDisplay();

          return {
            getValue: () => selectedValue,
            setValue: (val) => {
              selectedValue = val;
              updateDisplay();
            },
          };
        }


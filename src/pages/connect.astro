          }
        });

        function exportApplicationsCsv() {
          const apps = rawData.applications || [];
          if (apps.length === 0) {
            showToast("No application data to export.", "info");
            return;
          }

          const headers = [
            "Timestamp",
            "Name",
            "Email",
            "Phone",
            "Date of Birth",
            "Gender",
            "Locality",
            "Social",
            "Occupation Type",
            "College or Company",
            "Rotaract Status",
            "Why Join",
            "Club Name",
            "Journey",
            "Hobbies",
            "Contribute",
            "Contribute (Other)",
            "Current Status",
            "Last Reviewer",
            "Last Reviewed At",
            "Reviewer Notes History",
          ];

          const rows = apps.map((a) => [
            a.timestamp || "",
            a.name || "",
            a.email || "",
            a.phone || "",
            a.dob || "",
            a.gender || "",
            a.address || "",
            a.social || "",
            a.organizationType || "",
            a.organization || "",
            a.rotaractStatus || "",
            a.why || "",
            a.clubName || "",
            a.journey || "",
            a.hobbies || "",
            a.contribute || "",
            a.contributeOther || "",
            a.status || "Pending",
            a.lastReviewer || "",
            a.lastReviewedAt || "",
            a.notes || "",
          ]);

          downloadCsv(headers, rows, "rbe-member-applications-" + getTodayIso() + ".csv");
          showToast("Exported " + apps.length + " applications to CSV.", "download");
        }

        function exportSubscribersCsv() {
          if (activeSubTab === "news") {
            const subs = rawData.subscribers || [];
            if (subs.length === 0) {
              showToast("No subscriber data to export.", "info");
              return;
            }
            const headers = ["Timestamp", "Email"];
            const rows = subs.map((s) => [s.timestamp || "", s.email || ""]);
            downloadCsv(headers, rows, "rbe-newsletter-subscribers-" + getTodayIso() + ".csv");
            showToast("Exported " + subs.length + " subscribers to CSV.", "download");
          } else {
            const msgs = rawData.contactMessages || [];
            if (msgs.length === 0) {
              showToast("No contact messages to export.", "info");
              return;
            }
            const headers = ["Timestamp", "Name", "Email", "Phone", "Message"];
            const rows = msgs.map((m) => [m.timestamp || "", m.name || "", m.email || "", m.phone || "", m.message || ""]);
            downloadCsv(headers, rows, "rbe-contact-messages-" + getTodayIso() + ".csv");
            showToast("Exported " + msgs.length + " contact inquiries to CSV.", "download");
          }
        }

        function downloadCsv(headers, rows, filename) {
          const escapeCell = (val) => {
            const str = String(val == null ? "" : val);
            if (str.search(/("|,|\n|\r)/g) >= 0) {
              return '"' + str.replace(/"/g, '""') + '"';
            }
            return str;
          };

          const csvLines = [];
          csvLines.push(headers.map(escapeCell).join(","));
          rows.forEach((r) => {
            csvLines.push(r.map(escapeCell).join(","));
          });

          // UTF-8 BOM for Microsoft Excel compatibility
          const blob = new Blob(["\uFEFF" + csvLines.join("\r\n")], { type: "text/csv;charset=utf-8;" });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        }

        function getTodayIso() {
          return new Date().toISOString().split("T")[0];
        }

        function escapeHtml(str) {
          if (!str) return "";
          return String(str)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
        }

        init();
      })();
    </script>

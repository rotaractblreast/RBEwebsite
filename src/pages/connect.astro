        function setupInstallPrompts() {
          if (isStandalone) {
            return;
          }

          // Chrome / Edge / Android install prompt
          window.addEventListener("beforeinstallprompt", (e) => {
            e.preventDefault();
            deferredInstallPrompt = e;
            if (installAppBtn) {
              installAppBtn.classList.remove("hidden");
              installAppBtn.classList.add("inline-flex");
            }
            if (loginInstallWrap) {
              loginInstallWrap.classList.remove("hidden");
            }
          });

          // iOS Safari detection
          if (isIos && !isStandalone) {
            if (installAppBtn) {
              installAppBtn.classList.remove("hidden");
              installAppBtn.classList.add("inline-flex");
            }
            if (loginInstallWrap) {
              loginInstallWrap.classList.remove("hidden");
            }
          }

          async function triggerInstallFlow() {
            if (deferredInstallPrompt) {
              deferredInstallPrompt.prompt();
              const choice = await deferredInstallPrompt.userChoice;
              if (choice && choice.outcome === "accepted") {
                if (installAppBtn) installAppBtn.classList.add("hidden");
                if (loginInstallWrap) loginInstallWrap.classList.add("hidden");
                showToast("RBE Connect installed successfully!", "done");
              }
              deferredInstallPrompt = null;
            } else if (isIos) {
              if (iosInstallModal) iosInstallModal.classList.remove("hidden");
            } else {
              showToast("Use your browser's menu to select 'Install App' or 'Add to Home screen'.", "info");
            }
          }

          if (installAppBtn) installAppBtn.addEventListener("click", triggerInstallFlow);
          if (loginInstallBtn) loginInstallBtn.addEventListener("click", triggerInstallFlow);

          if (iosInstallClose) {
            iosInstallClose.addEventListener("click", () => iosInstallModal.classList.add("hidden"));
          }
          if (iosInstallDone) {
            iosInstallDone.addEventListener("click", () => iosInstallModal.classList.add("hidden"));
          }
          if (iosInstallModal) {
            iosInstallModal.addEventListener("click", (e) => {
              if (e.target === iosInstallModal) {
                iosInstallModal.classList.add("hidden");
              }
            });
          }
        }

        // Web Audio API synthesized notification sound (zero external asset dependencies)
        function playAlertChime() {
          try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            const ctx = new AudioCtx();
            if (ctx.state === "suspended") {
              ctx.resume();
            }
            const osc1 = ctx.createOscillator();
            const osc2 = ctx.createOscillator();
            const gain = ctx.createGain();

            osc1.type = "sine";
            osc1.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
            osc1.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.15); // A5

            osc2.type = "triangle";
            osc2.frequency.setValueAtTime(440, ctx.currentTime); // A4
            osc2.frequency.exponentialRampToValueAtTime(659.25, ctx.currentTime + 0.15); // E5

            gain.gain.setValueAtTime(0.2, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);

            osc1.connect(gain);
            osc2.connect(gain);
            gain.connect(ctx.destination);

            osc1.start(ctx.currentTime);
            osc2.start(ctx.currentTime);
            osc1.stop(ctx.currentTime + 0.35);
            osc2.stop(ctx.currentTime + 0.35);
          } catch (e) {}
        }

        // Trigger system notification via ServiceWorker or fallback Notification API
        async function triggerSystemNotification(title, body, data = {}) {
          playAlertChime();
          const options = {
            body: body || "",
            icon: "/icons/icon-192.png",
            badge: "/images/site/favicon.png",
            vibrate: [150, 80, 150],
            data: Object.assign({ url: "/connect/" }, data),
          };

          try {
            if (swRegistration && "showNotification" in swRegistration) {
              await swRegistration.showNotification(title, options);
            } else if ("Notification" in window && Notification.permission === "granted") {
              const n = new Notification(title, options);
              n.onclick = () => {
                window.focus();
                n.close();
              };
            }
          } catch (err) {
            console.warn("Could not display native notification:", err);
          }
        }

        function updateNotificationStatus() {
          const isDashboardVisible = dashboardScreen && !dashboardScreen.classList.contains("hidden");

          if (!("Notification" in window)) {
            if (notifStatusBadge) {
              notifStatusBadge.textContent = "Unsupported";
              notifStatusBadge.className =
                "px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-stone-100 text-stone-500 border border-stone-200";
            }
            if (notifEnableBtn) notifEnableBtn.disabled = true;
            if (notifPersistentBanner) notifPersistentBanner.classList.add("hidden");
            if (notifForceModal) notifForceModal.classList.add("hidden");
            return;
          }

          const perm = Notification.permission;
          if (perm === "granted") {
            if (notifStatusBadge) {
              notifStatusBadge.textContent = "Active";
              notifStatusBadge.className =
                "px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200";
            }
            if (notifActiveDot) notifActiveDot.classList.remove("hidden");
            if (notifIcon) notifIcon.textContent = "notifications_active";
            if (notifEnableText) notifEnableText.textContent = "Notifications Enabled";
            if (notifEnableBtn) {
              notifEnableBtn.classList.remove("bg-[#ff9000]", "text-stone-950", "hover:bg-[#e07f00]");
              notifEnableBtn.classList.add("bg-emerald-600", "text-white", "hover:bg-emerald-700");
            }
            if (notifPersistentBanner) notifPersistentBanner.classList.add("hidden");
            if (notifForceModal) notifForceModal.classList.add("hidden");
          } else if (perm === "denied") {
            if (notifStatusBadge) {
              notifStatusBadge.textContent = "Blocked";
              notifStatusBadge.className =
                "px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-rose-50 text-rose-700 border border-rose-200";
            }
            if (notifActiveDot) notifActiveDot.classList.add("hidden");
            if (notifIcon) notifIcon.textContent = "notifications_off";
            if (notifEnableText) notifEnableText.textContent = "Blocked in Browser Settings";
            if (notifEnableBtn) notifEnableBtn.disabled = true;

            if (isDashboardVisible && notifPersistentBanner) {
              notifPersistentBanner.classList.remove("hidden");
              if (notifBannerBadge) {
                notifBannerBadge.textContent = "Blocked";
                notifBannerBadge.className = "px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-rose-100 text-rose-800 border border-rose-200";
              }
              if (notifBannerDesc) {
                notifBannerDesc.textContent = "Notifications are blocked in your browser settings. To receive candidate alerts, click the lock/settings icon in your browser address bar and set Notifications to Allow.";
              }
              if (notifBannerBtnText) notifBannerBtnText.textContent = "Blocked in Settings";
              if (notifBannerEnableBtn) {
                notifBannerEnableBtn.classList.remove("bg-[#ff9000]", "hover:bg-[#e07f00]", "text-stone-950");
                notifBannerEnableBtn.classList.add("bg-stone-200", "text-stone-600", "hover:bg-stone-300");
              }
            } else if (notifPersistentBanner) {
              notifPersistentBanner.classList.add("hidden");
            }
            if (notifForceModal) notifForceModal.classList.add("hidden");
          } else {
            // perm === "default"
            if (notifStatusBadge) {
              notifStatusBadge.textContent = "Not Enabled";
              notifStatusBadge.className =
                "px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-50 text-amber-800 border border-amber-200";
            }
            if (notifActiveDot) notifActiveDot.classList.add("hidden");
            if (notifIcon) notifIcon.textContent = "notifications";
            if (notifEnableText) notifEnableText.textContent = "Enable Push Notifications";
            if (notifEnableBtn) {
              notifEnableBtn.disabled = false;
              notifEnableBtn.classList.add("bg-[#ff9000]", "text-stone-950", "hover:bg-[#e07f00]");
              notifEnableBtn.classList.remove("bg-emerald-600", "text-white", "hover:bg-emerald-700");
            }

            if (isDashboardVisible) {
              if (notifPersistentBanner) {
                notifPersistentBanner.classList.remove("hidden");
                if (notifBannerBadge) {
                  notifBannerBadge.textContent = "Action Required";
                  notifBannerBadge.className = "px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-200/90 text-amber-950 border border-amber-300";
                }
                if (notifBannerDesc) {
                  notifBannerDesc.textContent = "Never miss an applicant. Turn on instant notifications to receive real-time alerts on this device whenever a candidate submits a membership application.";
                }
                if (notifBannerBtnText) notifBannerBtnText.textContent = "Turn On Notifications";
                if (notifBannerEnableBtn) {
                  notifBannerEnableBtn.classList.add("bg-[#ff9000]", "hover:bg-[#e07f00]", "text-stone-950");
                  notifBannerEnableBtn.classList.remove("bg-stone-200", "text-stone-600", "hover:bg-stone-300");
                }
              }

              // Show force modal on landing if not dismissed in this session
              const dismissed = sessionStorage.getItem("rbe_notif_modal_dismissed");
              if (!dismissed && notifForceModal) {
                notifForceModal.classList.remove("hidden");
              }
            } else {
              if (notifPersistentBanner) notifPersistentBanner.classList.add("hidden");
              if (notifForceModal) notifForceModal.classList.add("hidden");
            }
          }
        }

        // OneSignal Web Push Integration
        let activeOneSignalAppId = "";
        let oneSignalInitialized = false;

        function initOneSignal(appId) {
          if (!appId || oneSignalInitialized) return;
          activeOneSignalAppId = appId;
          oneSignalInitialized = true;

          window.OneSignalDeferred = window.OneSignalDeferred || [];
          window.OneSignalDeferred.push(async function (OneSignal) {
            try {
              await OneSignal.init({
                appId: appId,
                serviceWorkerPath: "OneSignalSDKWorker.js",
                serviceWorkerParam: { scope: "/" },
                allowLocalhostAsSecureOrigin: true,
              });

              if (OneSignal.Notifications && OneSignal.Notifications.addEventListener) {
                OneSignal.Notifications.addEventListener("permissionChange", () => {
                  updateNotificationStatus();
                });
              }
              updateNotificationStatus();
            } catch (err) {
              console.warn("OneSignal init warning:", err);
            }
          });
        }

        async function requestNotificationPermission() {
          if (window.OneSignal && window.OneSignal.Notifications) {
            try {
              await window.OneSignal.Notifications.requestPermission();
              updateNotificationStatus();
              if (Notification.permission === "granted") {
                showToast("Push notifications enabled!", "done");
                triggerSystemNotification(
                  "RBE Connect Alerts Active",
                  "You will receive instant alerts whenever new candidates apply to join RBE."
                );
              } else if (Notification.permission === "denied") {
                showToast("Notifications were blocked. Please enable them in browser settings.", "warning");
              }
              return;
            } catch (e) {
              console.warn("OneSignal permission request failed, using native fallback:", e);
            }
          }

          if (!("Notification" in window)) {
            showToast("This browser does not support push notifications.", "error");
            return;
          }
          try {
            const perm = await Notification.requestPermission();
            updateNotificationStatus();
            if (perm === "granted") {
              showToast("Notifications enabled!", "done");
              triggerSystemNotification(
                "RBE Connect Alerts Active",
                "You will receive instant alerts whenever new candidates apply to join RBE."
              );
            } else if (perm === "denied") {
              showToast("Notifications were blocked. Please enable them in browser settings.", "warning");
            }
          } catch (err) {
            console.error("Notification permission request failed:", err);
          }
        }

        function setupNotifications() {
          updateNotificationStatus();

          if (notifToggleBtn && notifPopover) {
            notifToggleBtn.addEventListener("click", (e) => {
              e.stopPropagation();
              const isHidden = notifPopover.classList.contains("hidden");
              notifPopover.classList.toggle("hidden", !isHidden);
              if (notifPopoverBackdrop) {
                notifPopoverBackdrop.classList.toggle("hidden", !isHidden);
              }
              notifToggleBtn.setAttribute("aria-expanded", String(isHidden));
              updateNotificationStatus();
            });

            if (notifPopoverBackdrop) {
              notifPopoverBackdrop.addEventListener("click", () => {
                notifPopover.classList.add("hidden");
                notifPopoverBackdrop.classList.add("hidden");
                notifToggleBtn.setAttribute("aria-expanded", "false");
              });
            }

            document.addEventListener("click", (e) => {
              if (!notifPopover.contains(e.target) && !notifToggleBtn.contains(e.target)) {
                notifPopover.classList.add("hidden");
                if (notifPopoverBackdrop) notifPopoverBackdrop.classList.add("hidden");
                notifToggleBtn.setAttribute("aria-expanded", "false");
              }
            });

            if (notifEnableBtn) {
              notifEnableBtn.addEventListener("click", () => {
                if (Notification.permission !== "granted") {
                  requestNotificationPermission();
                } else {
                  showToast("Notifications are already active.", "done");
                }
              });
            }

            if (notifTestBtn) {
              notifTestBtn.addEventListener("click", async () => {
                if (Notification.permission !== "granted") {
                  await requestNotificationPermission();
                }
                if (Notification.permission === "granted") {
                  triggerSystemNotification(
                    "Test Notification - RBE Connect",
                    "Push & OS alert delivery is working smoothly on this device! 🚀"
                  );
                  showToast("Test notification sent.", "done");
                }
              });
            }
          }

          // Persistent Banner Button
          if (notifBannerEnableBtn) {
            notifBannerEnableBtn.addEventListener("click", () => {
              if (Notification.permission === "denied") {
                showToast("Notifications are blocked in browser settings. Please allow notifications in site settings.", "warning");
              } else {
                requestNotificationPermission();
              }
            });
          }

          // Persistent Force Modal Buttons
          if (notifModalEnableBtn) {
            notifModalEnableBtn.addEventListener("click", async () => {
              await requestNotificationPermission();
              if (Notification.permission === "granted") {
                if (notifForceModal) notifForceModal.classList.add("hidden");
              }
            });
          }

          if (notifModalDismissBtn) {
            notifModalDismissBtn.addEventListener("click", () => {
              sessionStorage.setItem("rbe_notif_modal_dismissed", "true");
              if (notifForceModal) notifForceModal.classList.add("hidden");
              showToast("You can enable notifications anytime from the banner above.", "info");
            });
          }
        }

        function startAutoPoll() {
          if (autoPollTimer) clearInterval(autoPollTimer);
          autoPollTimer = setInterval(() => {
            if (currentToken && !document.hidden) {
              fetchData(true, true); // silent background fetch bypassing cache
            }
          }, 60000);
        }

        // When tab or PWA regains focus / becomes visible, quietly refresh
        document.addEventListener("visibilitychange", () => {
          if (!document.hidden && currentToken) {
            fetchData(true, true);
          }
        });

        // Initialize / Session check with Stale-While-Revalidate caching
        async function init() {
          initCustomSelects();
          setupServiceWorker();
          setupInstallPrompts();
          setupNotifications();

          const appElem = document.getElementById("connect-app");
          const defaultAppId = appElem ? (appElem.getAttribute("data-onesignal") || "") : "";
          if (defaultAppId) {
            initOneSignal(defaultAppId);
          }

          if (currentToken && currentUser) {
            // 1. Stale-while-revalidate: display cached data instantly (<15ms)
            let cached = null;
            try {
              cached = localStorage.getItem("rbe_connect_data_cache") || sessionStorage.getItem("rbe_connect_data_cache");
            } catch (e) {}

            if (cached) {
              try {
                const parsed = JSON.parse(cached);
                rawData = {
                  applications: sortDescending(parsed.applications || []),
                  subscribers: sortDescending(parsed.subscribers || []),
                  contactMessages: sortDescending(parsed.contactMessages || []),
                };
                showDashboard();
                updateMetrics();
                renderApplications();
                renderSubscribers();
              } catch (e) {}
            } else {
              // Show dashboard shell immediately so there is no flickering login screen
              showDashboard();
            }

            // 2. Validate session with API and quietly revalidate
            try {
              const res = await apiPost({ action: "verifySession", token: currentToken });
              if (res.ok && res.user) {
                if (res.token) {
                  currentToken = res.token;
                  try {
                    localStorage.setItem("rbe_connect_token", currentToken);
                  } catch (e) {}
                }
                if (res.oneSignalAppId) {
                  initOneSignal(res.oneSignalAppId);
                }
                currentUser = res.user;
                try {
                  localStorage.setItem("rbe_connect_user", JSON.stringify(currentUser));
                } catch (e) {}
                showDashboard();
                await fetchData(Boolean(cached), false); // silent background fetch if cache was shown
                return;
              } else if (res.status === 401) {
                clearSession();
                showAuth();
                showToast("Session expired. Please log in again.", "lock");
                return;
              }
            } catch (e) {
              console.warn("Session check network error:", e);
              // Network blip or offline: keep reviewer logged in with local cached state
              if (cached || currentUser) {
                showDashboard();
                return;
              }
            }
          }
          showAuth();
        }

        function showAuth() {
          loadingEl.classList.add("hidden");
          dashboardScreen.classList.add("hidden");
          authScreen.classList.remove("hidden");
          if (autoPollTimer) {
            clearInterval(autoPollTimer);
            autoPollTimer = null;
          }
        }

        function showDashboard() {
          loadingEl.classList.add("hidden");
          authScreen.classList.add("hidden");
          dashboardScreen.classList.remove("hidden");
          if (userDisplay && currentUser) {
            userDisplay.textContent = currentUser.name + (currentUser.role ? " (" + currentUser.role + ")" : "");
          }
          startAutoPoll();
          updateNotificationStatus();
        }

        // Login Submit
        loginForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          loginAlert.classList.add("hidden");
          loginBtn.disabled = true;
          loginBtn.innerHTML = '<span class="inline-block animate-spin mr-2">⟳</span> Authenticating…';

          const email = document.getElementById("login-email").value.trim();
          const password = document.getElementById("login-password").value;
          const device = getDeviceSummary();

          try {
            const res = await apiPost({ action: "login", email, password, device });
            if (res.ok && res.token) {
              if (res.oneSignalAppId) {
                initOneSignal(res.oneSignalAppId);
              }
              currentToken = res.token;
              currentUser = res.user;
              try {
                localStorage.setItem("rbe_connect_token", currentToken);
                localStorage.setItem("rbe_connect_user", JSON.stringify(currentUser));
              } catch (e) {}
              showDashboard();
              await fetchData(false, true); // Fresh fetch after login
            } else {
              loginAlert.className = "mb-6 p-4 rounded-xl text-sm border bg-rose-50 border-rose-200 text-rose-800 flex items-start gap-3";
              loginAlert.innerHTML = '<span class="material-symbols-outlined text-lg mt-0.5">error</span><div>' + (res.error || "Authentication failed. Check credentials.") + '</div>';
              loginAlert.classList.remove("hidden");
            }
          } catch (err) {
            loginAlert.className = "mb-6 p-4 rounded-xl text-sm border bg-rose-50 border-rose-200 text-rose-800 flex items-start gap-3";
            loginAlert.innerHTML = '<span class="material-symbols-outlined text-lg mt-0.5">error</span><div>' + err.message + '</div>';
            loginAlert.classList.remove("hidden");
          } finally {
            loginBtn.disabled = false;
            loginBtn.innerHTML = '<span>Sign in to Dashboard</span><span class="material-symbols-outlined text-lg">arrow_forward</span>';
          }
        });

        // Logout with Double Confirmation Modal
        logoutBtn.addEventListener("click", () => {
          logoutModal.classList.remove("hidden");
        });

        logoutCancelBtn.addEventListener("click", () => {
          logoutModal.classList.add("hidden");
        });

        logoutConfirmBtn.addEventListener("click", () => {
          logoutModal.classList.add("hidden");
          const tokenToRevoke = currentToken;
          clearSession();
          showAuth();
          showToast("Logged out successfully.", "logout");
          if (tokenToRevoke) {
            apiPost({ action: "logout", token: tokenToRevoke }).catch(() => null);
          }
        });

        logoutModal.addEventListener("click", (e) => {
          if (e.target === logoutModal) {
            logoutModal.classList.add("hidden");
          }
        });

        // Refresh Data
        refreshBtn.addEventListener("click", async () => {
          await fetchData(false, true); // bypassCache = true on manual refresh
        });

        // Fetch Data from API with performance caching
        async function fetchData(isBackground = false, bypassCache = false) {
          if (!isBackground && refreshIcon) {
            refreshIcon.classList.add("animate-spin");
          }
          try {
            const res = await apiPost({
              action: "getData",
              token: currentToken,
              bypassCache: Boolean(bypassCache),
            });
            if (res.ok) {
              if (res.oneSignalAppId) {
                initOneSignal(res.oneSignalAppId);
              }
              const previousApps = rawData.applications || [];
              const incomingApps = sortDescending(res.applications || []);
              rawData = {
                applications: incomingApps,
                subscribers: sortDescending(res.subscribers || []),
                contactMessages: sortDescending(res.contactMessages || []),
              };
              try {
                localStorage.setItem("rbe_connect_data_cache", JSON.stringify(rawData));
              } catch (e) {}
              updateMetrics();
              renderApplications();
              renderSubscribers();

              // Detect new incoming applications and trigger notification
              if (previousApps.length > 0 && incomingApps.length > previousApps.length) {
                const prevKeys = new Set(previousApps.map((a) => a.id || (a.timestamp + "_" + a.email)));
                const newApps = incomingApps.filter((a) => !prevKeys.has(a.id || (a.timestamp + "_" + a.email)));
                if (newApps.length === 1) {
                  const c = newApps[0];
                  const org = c.organization || c.organizationType || "Candidate";
                  triggerSystemNotification(
                    "New Member Application: " + c.name,
                    c.name + " (" + org + ") just applied to join RBE!"
                  );
                } else if (newApps.length > 1) {
                  triggerSystemNotification(
                    newApps.length + " New Member Applications!",
                    newApps.map((a) => a.name).slice(0, 3).join(", ") + (newApps.length > 3 ? " and others" : "") + " applied to join RBE."
                  );
                }
              }

              if (!isBackground) {
                showToast("Data refreshed.", "done");
              }
            } else if (res.status === 401) {
              clearSession();
              showAuth();
              showToast("Session expired. Please log in again.", "lock");
            }
          } catch (err) {
            console.error("Failed to fetch data:", err);
            if (!isBackground) {
              showToast("Failed to fetch data: " + err.message, "error");
            }
          } finally {
            if (!isBackground && refreshIcon) {
              setTimeout(() => refreshIcon.classList.remove("animate-spin"), 500);
            }
          }
        }

        // Metrics Calculation
        function updateMetrics() {
          const apps = rawData.applications || [];
          statTotal.textContent = String(apps.length);
          badgeApps.textContent = String(apps.length);

          const pending = apps.filter((a) => (a.status || "Pending").toLowerCase() === "pending").length;
          const inReview = apps.filter((a) => {
            const s = (a.status || "").toLowerCase();
            return s === "under review" || s === "contacted";
          }).length;
          const accepted = apps.filter((a) => (a.status || "").toLowerCase() === "accepted").length;

          statPending.textContent = String(pending);
          statReview.textContent = String(inReview);
          statAccepted.textContent = String(accepted);

          const subs = rawData.subscribers || [];
          statSubscribers.textContent = String(subs.length);
          subNewsCount.textContent = String(subs.length);
          badgeSubs.textContent = String(subs.length + (rawData.contactMessages || []).length);
          subContactCount.textContent = String((rawData.contactMessages || []).length);
        }

        // Format note timestamp cleanly (e.g., "11 Sep 2026, 20:07")
        function formatNoteTime(ts) {
          if (!ts) return "";
          try {
            const parts = ts.trim().split(" ");
            if (parts.length >= 2) {
              const dateParts = parts[0].split("-");
              if (dateParts.length === 3) {
                const year = dateParts[0];
                const monthIndex = parseInt(dateParts[1], 10) - 1;
                const day = parseInt(dateParts[2], 10);
                const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                const month = months[monthIndex] || dateParts[1];
                return `${day} ${month} ${year}, ${parts[1]}`;
              }
            }
          } catch (e) {}
          return ts;
        }

        // Parse structured notes chain (supports pipe and hyphen formats)
        function parseNotesChain(notesStr) {
          if (!notesStr || !notesStr.trim()) return [];
          const rawEntries = notesStr.split(/\n\n+/).filter(Boolean);
          return rawEntries.map((entry) => {
            const match =
              entry.match(/^\[(\d{4}[-/]\d{2}[-/]\d{2}(?:\s+\d{2}:\d{2}(?::\d{2})?)?)\s*(?:\||\s+-\s+)\s*([^\]]+)\]:\s*([\s\S]*)$/) ||
              entry.match(/^\[([^\]|]+?)\s*\|\s*([^\]]+?)\]:\s*([\s\S]*)$/) ||
              entry.match(/^\[([^\]]+)\]:\s*([\s\S]*)$/);
            if (match) {
              if (match.length >= 4) {
                return {
                  timestamp: match[1].trim(),
                  author: match[2].trim(),
                  text: match[3].trim(),
                };
              } else {
                return {
                  timestamp: "",
                  author: match[1].trim(),
                  text: match[2].trim(),
                };
              }
            }
            return {
              timestamp: "",
              author: "Reviewer",
              text: entry.trim(),
            };
          });
        }

        // Applications Rendering with Filters & Reviewer Attribution
        function renderApplications() {
          if (appsTbody) appsTbody.innerHTML = "";
          if (appsMobileFeed) appsMobileFeed.innerHTML = "";

          const query = (searchInput.value || "").toLowerCase().trim();
          const statusVal = filterStatusSelect ? filterStatusSelect.getValue() : "ALL";
          const occVal = filterOccupationSelect ? filterOccupationSelect.getValue() : "ALL";
          const expVal = filterExperienceSelect ? filterExperienceSelect.getValue() : "ALL";

          const filtered = (rawData.applications || []).filter((item) => {
            if (statusVal !== "ALL" && (item.status || "Pending") !== statusVal) return false;
            if (occVal !== "ALL" && (item.organizationType || "").toLowerCase() !== occVal) return false;
            if (expVal !== "ALL" && (item.rotaractStatus || "").toLowerCase() !== expVal) return false;

            if (query) {
              const fullStr = [
                item.name,
                item.email,
                item.phone,
                item.organization,
                item.address,
                item.why,
                item.lastReviewer,
                item.notes,
              ].join(" ").toLowerCase();
              if (!fullStr.includes(query)) return false;
            }
            return true;
          });

          if (filtered.length === 0) {
            noAppsState.classList.remove("hidden");
            return;
          }
          noAppsState.classList.add("hidden");

          filtered.forEach((item) => {
            // Latest note preview
            const notesArr = parseNotesChain(item.notes);
            const latestNote = notesArr.length > 0 ? notesArr[notesArr.length - 1] : null;

            // 1. Render Desktop Table Row (>= 640px)
            if (appsTbody) {
              const tr = document.createElement("tr");
              tr.className = "hover:bg-amber-50/40 transition-colors";
              tr.innerHTML = `
                <td class="py-4 px-4 sm:px-6 min-w-[200px]">
                  <div class="font-semibold text-stone-900">${escapeHtml(item.name)}</div>
                  <div class="text-xs text-stone-500 mt-0.5 flex flex-wrap items-center gap-2">
                    <a href="mailto:${escapeHtml(item.email)}" class="hover:text-[#8e4e00] hover:underline">${escapeHtml(item.email)}</a>
                    <span>•</span>
                    <a href="tel:${escapeHtml(item.phone)}" class="hover:text-[#8e4e00] hover:underline">${escapeHtml(item.phone)}</a>
                  </div>
                  <div class="text-[11px] text-stone-400 mt-1">${escapeHtml(item.timestamp || "")}</div>
                </td>
                <td class="py-4 px-4 hidden md:table-cell max-w-[160px]">
                  <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-stone-100 text-stone-700 border border-stone-200 capitalize">
                    ${escapeHtml(item.organizationType || "-")}
                  </span>
                  <div class="text-xs text-stone-600 mt-1 truncate" title="${escapeHtml(item.organization || "-")}">${escapeHtml(item.organization || "-")}</div>
                </td>
                <td class="py-4 px-4 hidden lg:table-cell whitespace-nowrap">
                  <span class="text-xs ${item.rotaractStatus === "experienced" ? "text-amber-800 font-semibold" : "text-stone-500"} capitalize">
                    ${escapeHtml(item.rotaractStatus || "new")}
                  </span>
                </td>
                <td class="py-4 px-4 whitespace-nowrap">
                  ${getStatusBadge(item.status)}
                </td>
                <td class="py-4 px-4 hidden sm:table-cell max-w-[240px]">
                  <div class="text-xs text-stone-700 truncate font-medium" title="${latestNote ? escapeHtml(latestNote.text) : ''}">
                    ${latestNote ? escapeHtml(latestNote.text) : '<span class="text-stone-400 italic font-normal">No remarks yet</span>'}
                  </div>
                  ${item.lastReviewer ? `
                    <div class="text-[11px] text-stone-400 mt-1 truncate flex items-center gap-1">
                      <span class="material-symbols-outlined text-[12px] text-amber-700">person</span>
                      <span>${escapeHtml(item.lastReviewer)}</span>
                      ${item.lastReviewedAt ? `<span>• ${escapeHtml(item.lastReviewedAt)}</span>` : ''}
                    </div>
                  ` : ''}
                </td>
                <td class="py-4 px-4 text-right whitespace-nowrap">
                  <button
                    type="button"
                    data-row="${item.rowIndex}"
                    class="btn-review px-3.5 py-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 text-xs font-semibold transition-colors cursor-pointer"
                  >
                    Review
                  </button>
                </td>
              `;
              const btnRev = tr.querySelector(".btn-review");
              if (btnRev) btnRev.addEventListener("click", () => openModal(item));
              appsTbody.appendChild(tr);
            }

            // 2. Render Mobile Feed Card (< 640px)
            if (appsMobileFeed) {
              const card = document.createElement("div");
              card.className = "bg-white border border-stone-200/90 rounded-2xl p-4 shadow-xs space-y-3";

              const cleanPhone = (item.phone || "").replace(/\D/g, "");
              const waPhone = cleanPhone.length === 10 ? "91" + cleanPhone : cleanPhone;

              card.innerHTML = `
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0 flex-1">
                    <h3 class="font-bold text-base text-stone-900 leading-tight truncate">${escapeHtml(item.name)}</h3>
                    <div class="text-[11px] text-stone-400 mt-0.5">${escapeHtml(item.timestamp || "Recent")}</div>
                  </div>
                  <div class="shrink-0">
                    ${getStatusBadge(item.status)}
                  </div>

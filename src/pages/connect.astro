---
import "@/styles/global.css";
import { SITE } from "@/lib/site";

// Empty until the Apps Script Web App is deployed or set in env
const formsApi =
  import.meta.env.PUBLIC_FORMS_API_URL ||
  process.env.PUBLIC_FORMS_API_URL ||
  "";

// OneSignal App ID (optional env override, or loaded dynamically from Apps Script Config)
const oneSignalAppId =
  import.meta.env.PUBLIC_ONESIGNAL_APP_ID ||
  process.env.PUBLIC_ONESIGNAL_APP_ID ||
  "";
---

<!DOCTYPE html>
<html lang="en-IN" class="h-full bg-[#fff8f5] text-[#231a11]">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ff9000" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>Connect Portal | {SITE.title}</title>
    <link rel="manifest" href="/connect-manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="RBE Connect" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="RBE Connect" />
    <link rel="shortcut icon" href="/images/site/favicon.png" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
    <!-- OneSignal Web Push SDK v16 for native background lock-screen notifications -->
    <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
  </head>
  <body class="min-h-full flex flex-col font-sans antialiased text-[#231a11] bg-[#fff8f5]">
    <div id="connect-app" data-api={formsApi} data-onesignal={oneSignalAppId} class="flex-1 flex flex-col">
      <!-- Loading Screen -->
      <div id="app-loading" class="flex-1 flex items-center justify-center p-6">
        <div class="flex flex-col items-center gap-4 text-center">
          <div class="h-10 w-10 border-4 border-[#ff9000] border-t-transparent rounded-full animate-spin"></div>
          <p class="text-sm text-stone-600 font-medium">Initializing RBE Connect Portal…</p>
        </div>
      </div>

      <!-- Auth Screen -->
      <div id="auth-screen" class="hidden flex-1 flex items-center justify-center p-4 sm:p-6 md:p-8">
        <div class="w-full max-w-md bg-white border border-stone-200/90 rounded-2xl shadow-xl p-6 sm:p-8">
          <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center h-14 w-14 rounded-2xl bg-amber-50 border border-amber-200 text-[#8e4e00] mb-4 shadow-xs">
              <span class="material-symbols-outlined text-3xl">badge</span>
            </div>
            <h1 class="text-2xl font-bold font-display text-stone-900 tracking-tight">RBE Connect</h1>
            <p class="text-sm text-stone-600 mt-1">Member Applications & Reviewer Portal</p>
          </div>

          <div id="login-alert" class="hidden mb-6 p-4 rounded-xl text-sm border flex items-start gap-3"></div>

          <form id="login-form" class="space-y-5">
            <div>
              <label for="login-email" class="block text-xs font-semibold uppercase tracking-wider text-stone-700 mb-2">Reviewer Email</label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400 text-xl pointer-events-none">mail</span>
                <input
                  type="email"
                  id="login-email"
                  required
                  placeholder="reviewer@rotaractblreast.org"
                  class="w-full pl-11 pr-4 py-3 bg-stone-50/70 border border-stone-300 rounded-xl text-stone-900 placeholder-stone-400 text-sm focus:bg-white focus:outline-none focus:border-[#ff9000] focus:ring-1 focus:ring-[#ff9000] transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="login-password" class="block text-xs font-semibold uppercase tracking-wider text-stone-700 mb-2">Password</label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400 text-xl pointer-events-none">lock</span>
                <input
                  type="password"
                  id="login-password"
                  required
                  placeholder="••••••••"
                  class="w-full pl-11 pr-11 py-3 bg-stone-50/70 border border-stone-300 rounded-xl text-stone-900 placeholder-stone-400 text-sm focus:bg-white focus:outline-none focus:border-[#ff9000] focus:ring-1 focus:ring-[#ff9000] transition-colors"
                />
                <button
                  type="button"
                  id="toggle-password"
                  class="absolute right-3.5 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-700 text-xl focus:outline-none"
                  aria-label="Toggle password visibility"
                >
                  <span class="material-symbols-outlined text-xl">visibility</span>
                </button>
              </div>
            </div>

            <button
              type="submit"
              id="login-btn"
              class="w-full mt-2 py-3 px-4 bg-[#ff9000] hover:bg-[#e07f00] text-stone-950 font-bold rounded-xl text-sm transition-all duration-150 flex items-center justify-center gap-2 shadow-md shadow-amber-500/20 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span>Sign in to Dashboard</span>
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </button>
          </form>

          <div class="mt-8 pt-6 border-t border-stone-200/80 text-center">
            <p class="text-xs text-stone-500">
              Access restricted to authorized RBE Board & Reviewers.
            </p>
            <div id="login-install-wrap" class="hidden mt-4 pt-3 border-t border-stone-100 flex justify-center">
              <button
                type="button"
                id="login-install-btn"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-900 text-xs font-semibold transition-colors cursor-pointer"
              >
                <span class="material-symbols-outlined text-sm">install_mobile</span>
                <span>Install Connect App</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Dashboard -->
      <div id="dashboard-screen" class="hidden flex-1 flex flex-col">
        <!-- Top Navigation -->
        <header class="bg-white/95 backdrop-blur border-b border-stone-200/90 sticky top-0 z-30 shadow-xs">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <a href="/" class="flex items-center gap-2.5 text-stone-900 hover:opacity-90 transition-opacity">
                <img src="/images/site/favicon.png" alt="RBE" class="h-8 w-8 rounded-lg" />
                <span class="font-display font-bold text-lg tracking-tight hidden sm:inline text-stone-900">RBE Connect</span>
              </a>
              <span class="hidden md:inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-900 border border-amber-200">
                Reviewer Portal
              </span>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
              <div class="hidden sm:flex items-center gap-2 bg-stone-50 border border-stone-200 px-3 py-1.5 rounded-xl text-xs">
                <span class="material-symbols-outlined text-[#8e4e00] text-base">person</span>
                <span id="user-display" class="font-medium text-stone-700">Reviewer</span>
              </div>

              <!-- Install App Button (Visible when install prompt is available or for iOS) -->
              <button
                type="button"
                id="install-app-btn"
                title="Install Connect App on your device"
                class="hidden items-center gap-1 px-2.5 sm:px-3 py-1.5 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 text-[#8e4e00] border border-amber-300 text-xs font-semibold transition-colors cursor-pointer"
              >
                <span class="material-symbols-outlined text-base">download_for_offline</span>
                <span class="hidden md:inline">Install App</span>
              </button>

              <!-- Notifications Toggle & Popover -->
              <div class="relative">
                <button
                  type="button"
                  id="notif-toggle-btn"
                  title="Application Alerts & Push Notifications"
                  class="p-2 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-600 hover:text-stone-900 transition-colors flex items-center justify-center border border-stone-200/60 relative cursor-pointer"
                  aria-expanded="false"
                  aria-haspopup="dialog"
                >
                  <span class="material-symbols-outlined text-xl" id="notif-icon">notifications</span>
                  <span id="notif-active-dot" class="hidden absolute top-1.5 right-1.5 h-2 w-2 rounded-full bg-emerald-500 ring-2 ring-white"></span>
                </button>

                <!-- Notifications Popover Backdrop on mobile -->
                <div id="notif-popover-backdrop" class="hidden fixed inset-0 bg-stone-950/20 backdrop-blur-[2px] z-40 sm:hidden"></div>

                <!-- Notifications Popover -->
                <div
                  id="notif-popover"
                  class="hidden fixed sm:absolute left-3 right-3 sm:left-auto sm:right-0 top-16 sm:top-full mt-2 sm:w-80 bg-white border border-stone-200/90 rounded-2xl shadow-2xl sm:shadow-xl p-4 sm:p-5 z-50 animate-in fade-in zoom-in-95 duration-150 text-stone-900 max-w-sm sm:max-w-none mx-auto sm:mx-0"
                >
                  <div class="flex items-center justify-between border-b border-stone-100 pb-3 mb-3">
                    <div class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-[#ff9000] text-xl">campaign</span>
                      <h4 class="font-bold text-sm text-stone-900">Push Notifications</h4>
                    </div>
                    <span id="notif-status-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-stone-100 text-stone-600 border border-stone-200">
                      Checking
                    </span>
                  </div>

                  <p class="text-xs text-stone-500 mb-4 leading-relaxed">
                    Get instant OS & PWA alerts whenever a new member application is submitted from the website.
                  </p>

                  <div class="space-y-2.5">
                    <button
                      type="button"
                      id="notif-enable-btn"
                      class="w-full py-2.5 px-3 bg-[#ff9000] hover:bg-[#e07f00] text-stone-950 font-bold rounded-xl text-xs flex items-center justify-center gap-2 transition-all cursor-pointer shadow-xs"
                    >
                      <span class="material-symbols-outlined text-base">notifications_active</span>
                      <span id="notif-enable-text">Enable Notifications</span>
                    </button>

                    <button
                      type="button"
                      id="notif-test-btn"
                      class="w-full py-2 px-3 bg-stone-100 hover:bg-stone-200 text-stone-700 font-semibold rounded-xl text-xs flex items-center justify-center gap-2 transition-colors cursor-pointer"
                    >
                      <span class="material-symbols-outlined text-base">send_to_mobile</span>
                      <span>Send Test Notification</span>
                    </button>
                  </div>

                  <div class="mt-4 pt-3 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
                    <div class="flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-stone-400 text-sm">alarm</span>
                      <span>Auto-check for new apps</span>
                    </div>
                    <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md">Every 60s</span>
                  </div>
                </div>
              </div>

              <button
                type="button"
                id="refresh-btn"
                title="Refresh latest data"
                class="p-2 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-600 hover:text-stone-900 transition-colors flex items-center justify-center border border-stone-200/60 cursor-pointer"
              >
                <span class="material-symbols-outlined text-xl" id="refresh-icon">sync</span>
              </button>

              <button
                type="button"
                id="logout-btn"
                class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold transition-colors cursor-pointer"
              >
                <span class="material-symbols-outlined text-base">logout</span>
                <span class="hidden sm:inline">Log out</span>
              </button>
            </div>
          </div>
        </header>

        <!-- Main Workspace -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
          <!-- Persistent Notification Activation Banner (Visible when notifications are not enabled) -->
          <div
            id="notif-persistent-banner"
            class="hidden p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-amber-500/15 via-orange-500/10 to-amber-500/5 border border-amber-400/70 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
          >
            <div class="flex items-start gap-3.5">
              <div class="h-10 w-10 sm:h-11 sm:w-11 rounded-xl sm:rounded-2xl bg-[#ff9000] text-stone-950 flex items-center justify-center shrink-0 shadow-xs">
                <span class="material-symbols-outlined text-2xl animate-pulse">notifications_active</span>
              </div>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="font-extrabold text-stone-950 text-sm sm:text-base">
                    Enable Application Push Notifications
                  </h3>
                  <span id="notif-banner-badge" class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-200/90 text-amber-950 border border-amber-300">
                    Action Required
                  </span>
                </div>
                <p id="notif-banner-desc" class="text-xs text-stone-700 mt-1 leading-relaxed max-w-2xl font-medium">
                  Never miss an applicant. Turn on instant notifications to receive real-time alerts on this device whenever a candidate submits a membership application.
                </p>
              </div>
            </div>
            <button
              type="button"
              id="notif-banner-enable-btn"
              class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-[#ff9000] hover:bg-[#e07f00] active:scale-[0.98] text-stone-950 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all cursor-pointer shrink-0 shadow-sm"
            >
              <span class="material-symbols-outlined text-lg">notifications_active</span>
              <span id="notif-banner-btn-text">Turn On Notifications</span>
            </button>
          </div>

          <!-- Metric Tiles -->
          <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="bg-white border border-stone-200/90 rounded-2xl p-4 sm:p-5 shadow-xs min-w-0">
              <div class="flex items-center justify-between text-stone-500 text-xs font-medium uppercase tracking-wider mb-2">
                <span class="truncate">Total Applications</span>
                <span class="material-symbols-outlined text-base text-stone-400">description</span>
              </div>
              <p id="stat-total" class="text-2xl sm:text-3xl font-bold font-display text-stone-900">0</p>
            </div>

            <div class="bg-white border border-amber-200/70 rounded-2xl p-4 sm:p-5 shadow-xs min-w-0">
              <div class="flex items-center justify-between text-amber-800 text-xs font-medium uppercase tracking-wider mb-2">
                <span class="truncate">Pending</span>
                <span class="material-symbols-outlined text-base text-amber-600">pending</span>
              </div>
              <p id="stat-pending" class="text-2xl sm:text-3xl font-bold font-display text-[#8e4e00]">0</p>
            </div>

            <div class="bg-white border border-blue-200/70 rounded-2xl p-4 sm:p-5 shadow-xs min-w-0">
              <div class="flex items-center justify-between text-blue-700 text-xs font-medium uppercase tracking-wider mb-2">
                <span class="truncate">In Review</span>
                <span class="material-symbols-outlined text-base text-blue-600">search</span>
              </div>
              <p id="stat-review" class="text-2xl sm:text-3xl font-bold font-display text-blue-700">0</p>
            </div>

            <div class="bg-white border border-emerald-200/70 rounded-2xl p-4 sm:p-5 shadow-xs min-w-0">
              <div class="flex items-center justify-between text-emerald-700 text-xs font-medium uppercase tracking-wider mb-2">
                <span class="truncate">Accepted</span>
                <span class="material-symbols-outlined text-base text-emerald-600">check_circle</span>
              </div>
              <p id="stat-accepted" class="text-2xl sm:text-3xl font-bold font-display text-emerald-700">0</p>
            </div>

            <div class="col-span-2 lg:col-span-1 bg-white border border-purple-200/70 rounded-2xl p-4 sm:p-5 shadow-xs min-w-0">
              <div class="flex items-center justify-between text-purple-700 text-xs font-medium uppercase tracking-wider mb-2">
                <span class="truncate">Subscribers</span>
                <span class="material-symbols-outlined text-base text-purple-600">mail</span>
              </div>
              <p id="stat-subscribers" class="text-2xl sm:text-3xl font-bold font-display text-purple-700">0</p>
            </div>
          </div>

          <!-- Tab Navigation -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-200 pb-4">
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="tab-btn-applications"
                class="tab-btn active px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors flex items-center gap-2 bg-[#ff9000] text-stone-950 shadow-sm"
              >
                <span class="material-symbols-outlined text-lg">person_add</span>
                <span>Member Applications</span>
                <span id="badge-applications" class="ml-1 px-2 py-0.5 rounded-full text-xs font-bold bg-stone-950/15">0</span>
              </button>
              <button
                type="button"
                id="tab-btn-subscribers"
                class="tab-btn px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors flex items-center gap-2 bg-white text-stone-700 border border-stone-200 hover:text-stone-900 hover:bg-stone-50"
              >
                <span class="material-symbols-outlined text-lg">mark_email_read</span>
                <span>Subscribers & Messages</span>
                <span id="badge-subscribers" class="ml-1 px-2 py-0.5 rounded-full text-xs font-bold bg-stone-100 text-stone-600">0</span>
              </button>
            </div>

            <div>
              <button
                type="button"
                id="export-csv-btn"
                class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-white text-sm font-semibold transition-colors flex items-center justify-center gap-2 border border-stone-800 shadow-xs"
              >
                <span class="material-symbols-outlined text-lg text-emerald-400">download</span>
                <span>Export Applications CSV</span>
              </button>
            </div>
          </div>

          <!-- View: Applications -->
          <div id="view-applications" class="space-y-5">
            <!-- Filter Bar with Custom Styled Dropdowns -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400 text-xl pointer-events-none">search</span>
                <input
                  type="text"
                  id="search-input"
                  placeholder="Search name, email, phone, college…"
                  class="w-full pl-10 pr-4 py-2.5 bg-white border border-stone-300 rounded-xl text-stone-900 placeholder-stone-400 text-sm focus:outline-none focus:border-[#ff9000] focus:ring-2 focus:ring-[#ff9000]/20 shadow-2xs transition-all"
                />
              </div>

              <!-- Custom Styled Select: Status -->
              <div id="filter-status-wrapper" class="relative"></div>

              <!-- Custom Styled Select: Occupation -->
              <div id="filter-occupation-wrapper" class="relative"></div>

              <!-- Custom Styled Select: Experience -->
              <div id="filter-experience-wrapper" class="relative"></div>
            </div>

            <!-- Mobile Applications Card Feed (Shown on mobile screens < 640px) -->
            <div id="applications-mobile-feed" class="sm:hidden space-y-3">
              <!-- Rendered dynamically -->
            </div>

            <!-- Desktop Applications Table (Hidden on mobile screens, shown >= 640px) -->
            <div class="hidden sm:block bg-white border border-stone-200/90 rounded-2xl overflow-hidden shadow-xs">
              <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-stone-700 min-w-[720px]">
                  <thead class="bg-stone-50/90 text-xs uppercase font-semibold text-stone-600 tracking-wider border-b border-stone-200">
                    <tr>
                      <th class="py-4 px-4 sm:px-6">Applicant</th>
                      <th class="py-4 px-4 hidden md:table-cell">Occupation</th>
                      <th class="py-4 px-4 hidden lg:table-cell">Rotaract</th>
                      <th class="py-4 px-4">Status</th>
                      <th class="py-4 px-4 hidden sm:table-cell">Latest Remark & Reviewer</th>
                      <th class="py-4 px-4 text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody id="applications-tbody" class="divide-y divide-stone-100">
                    <!-- Dynamic Rows -->
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Empty State -->
            <div id="no-apps-state" class="hidden p-10 sm:p-12 text-center text-stone-500 bg-white border border-stone-200/90 rounded-2xl">
              <span class="material-symbols-outlined text-4xl mb-2 text-stone-400">inbox</span>
              <p class="text-base font-medium text-stone-800">No matching applications found</p>
              <p class="text-xs text-stone-500 mt-1">Try clearing filters or search keywords.</p>
            </div>
          </div>

          <!-- View: Subscribers & Contact Messages -->
          <div id="view-subscribers" class="hidden space-y-6">
            <div class="flex items-center gap-3">
              <button
                type="button"
                id="sub-toggle-news"
                class="sub-toggle active px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-[#ff9000] text-stone-950 transition-colors"
              >
                Newsletter Subscribers (<span id="sub-news-count">0</span>)
              </button>
              <button
                type="button"
                id="sub-toggle-contact"
                class="sub-toggle px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white border border-stone-200 text-stone-700 hover:text-stone-900 transition-colors"
              >
                Contact Inquiries (<span id="sub-contact-count">0</span>)
              </button>
            </div>

            <!-- Newsletter Table -->
            <div id="sub-news-panel" class="bg-white border border-stone-200/90 rounded-2xl overflow-hidden shadow-xs">
              <!-- Mobile Cards (< 640px) -->
              <div id="subscribers-mobile-feed" class="sm:hidden space-y-2.5 p-3"></div>

              <!-- Desktop Table (>= 640px) -->
              <div class="hidden sm:block overflow-x-auto">
                <table class="w-full text-left text-sm text-stone-700 min-w-[500px]">
                  <thead class="bg-stone-50/90 text-xs uppercase font-semibold text-stone-600 tracking-wider border-b border-stone-200">
                    <tr>
                      <th class="py-3.5 px-6">Timestamp</th>
                      <th class="py-3.5 px-6">Email Address</th>
                      <th class="py-3.5 px-6 text-right">Action</th>
                    </tr>
                  </thead>
                  <tbody id="subscribers-tbody" class="divide-y divide-stone-100">
                    <!-- Dynamic Rows -->
                  </tbody>
                </table>
              </div>
              <div id="no-subs-state" class="hidden p-8 text-center text-stone-500">
                No newsletter subscribers found.
              </div>
            </div>

            <!-- Contact Messages Table -->
            <div id="sub-contact-panel" class="hidden bg-white border border-stone-200/90 rounded-2xl overflow-hidden shadow-xs">
              <!-- Mobile Cards (< 640px) -->

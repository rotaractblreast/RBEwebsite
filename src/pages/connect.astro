        // Update Audit Attribution Bar
        function updateAuditBar(reviewer, timestamp, status) {
          if (reviewer) {
            modalAuditText.innerHTML = `Last reviewed by <strong>${escapeHtml(reviewer)}</strong>${timestamp ? ' on ' + escapeHtml(timestamp) : ''}`;
            return;
          }
          const s = (status || (currentModalItem ? currentModalItem.status : "") || "Pending").toLowerCase();
          if (s !== "pending") {
            modalAuditText.innerHTML = `Status marked as <strong>${escapeHtml(status || currentModalItem.status)}</strong>`;
            return;
          }
          modalAuditText.textContent = "Not yet reviewed by team";
        }

        // Save Status Update (at bottom of modal)
        modalUpdateStatusBtn.addEventListener("click", async () => {
          if (!currentModalItem) return;
          const newStatus = modalStatusSelect ? modalStatusSelect.getValue() : "Pending";
          modalUpdateStatusBtn.disabled = true;
          modalUpdateStatusBtn.innerHTML = '<span class="inline-block animate-spin mr-1">⟳</span> Saving…';

          try {
            const res = await apiPost({
              action: "updateStatus",
              token: currentToken,
              rowIndex: currentModalItem.rowIndex,
              email: currentModalItem.email,
              timestamp: currentModalItem.timestamp,
              status: newStatus,
              reviewerName: currentUser ? currentUser.name : "Reviewer",
            });

            if (res.ok) {
              const reviewer = res.lastReviewer || (currentUser ? currentUser.name : "Reviewer");
              const nowIso = new Date().toISOString().replace("T", " ").substring(0, 16);
              const reviewedAt = res.lastReviewedAt || formatNoteTime(nowIso);

              currentModalItem.status = newStatus;
              currentModalItem.lastReviewer = reviewer;
              currentModalItem.lastReviewedAt = reviewedAt;
              if (res.rowIndex) currentModalItem.rowIndex = res.rowIndex;

              // Synchronize rawData item
              const target = (rawData.applications || []).find(
                (a) => a.email === currentModalItem.email && a.timestamp === currentModalItem.timestamp
              );
              if (target) {
                target.status = newStatus;
                target.lastReviewer = reviewer;
                target.lastReviewedAt = reviewedAt;
                if (res.rowIndex) target.rowIndex = res.rowIndex;
              }

              // Update client cache
              try {
                localStorage.setItem("rbe_connect_data_cache", JSON.stringify(rawData));
              } catch (e) {}

              modalStatusBadge.innerHTML = getStatusBadge(newStatus);
              updateAuditBar(reviewer, reviewedAt, newStatus);
              updateMetrics();
              renderApplications();
              showToast("Status updated to " + newStatus + ".", "check");
            } else {
              showToast("Failed to update status: " + (res.error || "Unknown error"), "error");
            }
          } catch (err) {
            showToast("Error updating status: " + err.message, "error");

        // Descending Date Sorting Helper (Latest submission on top)
        function parseTimestampEpoch(ts) {
          if (!ts) return 0;
          const s = String(ts).trim();
          const iso = s.replace(" ", "T");
          const t = Date.parse(iso);
          return isNaN(t) ? 0 : t;
        }

        function sortDescending(list) {
          return (list || []).slice().sort((a, b) => {
            const timeA = parseTimestampEpoch(a.timestamp);
            const timeB = parseTimestampEpoch(b.timestamp);
            if (timeA !== timeB) return timeB - timeA;
            return (b.rowIndex || 0) - (a.rowIndex || 0);
          });
        }


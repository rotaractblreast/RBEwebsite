---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import { getSiteSettings, getTeam } from "@/lib/content";
import type { TeamMember } from "@/lib/types";
import { SITE } from "@/lib/site";

const settings = await getSiteSettings();
const team = await getTeam();
// 7 members + the "Join the team" tile fills exactly two rows of the 4-column grid.
const preview = 7;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "Rotaract Club of Bangalore East",
  alternateName: ["Rotaract Bangalore East", "RBE", "Easterners"],
  url: SITE.url,
  email: settings.email,
  telephone: settings.phone,
  foundingDate: "1975-01-17",
  slogan: SITE.subtitle,
  description:
    "Rotaract Club of Bangalore East (Easterners) is a voluntary youth organization in Bangalore for young adults 18+. Dedicated to community service, leadership, and fellowship.",
  areaServed: {
    "@type": "City",
    name: "Bengaluru",
  },
  sameAs: Object.values(settings.siteSocial).filter(Boolean),
};

function initial(name: string) {
  const parts = name.trim().split(/\s+/);
  const last = parts[parts.length - 1] || name;
  return last.slice(0, 1).toUpperCase();
}

/** Tall 3:4 crop for the team grid. Anchored to the top so faces survive the crop. */
function teamPhoto(url: string) {
  if (!url.includes("cdn.sanity.io")) return url;
  return `${url}?w=600&h=800&fit=crop&crop=top&auto=format`;
}

const socialNetworks = [
  { key: "instagram", label: "Instagram" },
  { key: "linkedin", label: "LinkedIn" },
  { key: "twitter", label: "X (Twitter)" },
  { key: "facebook", label: "Facebook" },
] as const;

type MemberLink = {
  network: (typeof socialNetworks)[number]["key"];
  label: string;
  href: string;
};

function memberLinks(social: TeamMember["social"]): MemberLink[] {
  const links = social ?? {};
  return socialNetworks
    .filter((net) => links[net.key])
    .map((net) => ({ network: net.key, label: net.label, href: links[net.key] }));
}
---
<BaseLayout
  title="About Us"
  description="Learn about Rotaract Club of Bangalore East (Easterners), established in 1975 and rechartered in 2019. A voluntary youth organization for young adults 18+."
  jsonLd={jsonLd}
>
  <PageHero
    title="About Rotaract Bangalore East"
    eyebrow="Our Story · Since 1975"
    lead="A voluntary youth organization dedicated to leadership development, meaningful community service, and lifelong fellowship."
  />
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "About" }]} />

  <section class="section-pad pb-6">
    <div class="wrap max-w-3xl">
      <p class="text-body-lg text-on-surface-variant mb-6 leading-relaxed">
        Rotaract Club of Bangalore East, known as the Easterners, is a volunteer youth organization in Bengaluru. Established on January 17, 1975, rechartered on July 19, 2019, and sponsored by Rotary Bangalore East, the club brings together young adults 18 and older to lead community initiatives, hone professional skills, and build lifelong friendships.
      </p>
      <div class="grid sm:grid-cols-2 gap-4 my-8 p-6 rounded-2xl bg-surface-container-low border border-outline-variant/30">
        <div>
          <span class="block text-xs uppercase tracking-wider text-primary font-bold mb-1">Organization</span>
          <span class="text-sm font-semibold text-on-surface">Rotaract Club of Bangalore East</span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wider text-primary font-bold mb-1">Eligibility</span>
          <span class="text-sm font-semibold text-on-surface">Young adults aged 18+</span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wider text-primary font-bold mb-1">Charter History</span>
          <span class="text-sm font-semibold text-on-surface">Jan 17, 1975 · Rechartered Jul 19, 2019</span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wider text-primary font-bold mb-1">Affiliation</span>
          <span class="text-sm font-semibold text-on-surface">Rotary Bangalore East · District 3191</span>
        </div>
      </div>
      <p class="text-on-surface-variant mb-4">
        <strong class="text-on-surface">UNITE:</strong> We are a welcoming family where every member finds mentorship, belonging, and encouragement.<br />
        <strong class="text-on-surface">RISE:</strong> We cultivate leadership, communication, and professional growth through hands-on responsibility.<br />
        <strong class="text-on-surface">EMPOWER:</strong> We channel our collective energy into impactful community drives, education support, and social welfare across Bangalore.
      </p>
      <p class="text-on-surface-variant">
        Volunteer, collaborate, and support our initiatives. Let's experience the joy of giving back together.
      </p>
    </div>
  </section>

  <section class="relative section-pad overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/site/background-3.jpg"
        alt=""
        class="h-full w-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-inverse-surface/75"></div>
    </div>
    <div class="wrap relative grid md:grid-cols-2 gap-10 items-center text-inverse-on-surface">
      <img
        src="/images/site/feature-5.jpeg"
        alt="Fundraising for goodness"
        class="rounded-lg w-full object-cover aspect-[4/3]"
        loading="lazy"
      />
      <div>
        <p class="label-caps text-primary-fixed mb-3">Fundraising for goodness</p>
        <h2 class="font-display text-headline-lg text-white mb-4">Quick community response</h2>
        <p class="mb-6 text-inverse-on-surface/85">
          The support we give to the community is the rent we pay for our time on Earth. Be part of the
          change.
        </p>
        <a href="/causes/" class="btn btn-primary">Our causes</a>
      </div>
    </div>
  </section>

  <section class="section-pad bg-surface-container-low">
    <div class="wrap">
      <p class="label-caps text-center mb-2">Core values</p>
      <h2 class="font-display text-headline-lg text-center mb-10">UNITE · RISE · EMPOWER</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {
          settings.coreValues.map((value) => (
            <article class="card overflow-hidden">
              <div class="aspect-[16/10]">
                <img
                  src={value.image}
                  alt={value.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <h3 class="font-display text-headline-md mb-2">{value.title}</h3>
                <p class="text-on-surface-variant mb-4">{value.brief}</p>
                <a
                  href={value.target}
                  class="text-primary font-bold text-sm uppercase tracking-wider"
                >
                  Explore →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="team" class="section-pad scroll-mt-24">
    <div class="wrap">
      <p class="label-caps text-center mb-2">#TeamRBE</p>
      <h2 class="font-display text-headline-lg text-center mb-3">Our team</h2>
      <p class="text-on-surface-variant text-center max-w-xl mx-auto mb-8">
        The Easterners who plan the projects, show up on the ground, and keep the club running.
      </p>

      {
        team.length > 0 ? (
          <>
            <div
              id="team-grid"
              class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-5 mb-8"
            >
              {team.map((member, i) => (
                <article
                  class="team-card group relative overflow-hidden rounded-xl bg-surface-container-high"
                  hidden={i >= preview}
                  data-team-more={i >= preview ? true : undefined}
                >
                  {member.image ? (
                    <img
                      src={teamPhoto(member.image)}
                      alt=""
                      class="aspect-[3/4] w-full object-cover object-top"
                      loading="lazy"
                      decoding="async"
                      width="600"
                      height="800"
                    />
                  ) : (
                    <div
                      class="aspect-[3/4] w-full flex items-center justify-center bg-primary-container font-display text-5xl font-bold text-on-primary-container"
                      aria-hidden="true"
                    >
                      {initial(member.name)}
                    </div>
                  )}

                  <div
                    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/25 to-transparent"
                    aria-hidden="true"
                  />

                  <div class="absolute inset-x-0 bottom-0 p-2.5 sm:p-3">
                    <div class="team-plate rounded-lg bg-ink/45 px-2.5 py-2.5 text-center sm:px-3">
                      <h3 class="font-display text-sm sm:text-base font-semibold leading-snug text-white">
                        {member.featurelink ? (
                          <a
                            href={member.featurelink}
                            target="_blank"
                            rel="noopener"
                            class="underline-offset-2 hover:underline"
                          >
                            {member.name}
                          </a>
                        ) : (
                          member.name
                        )}
                      </h3>
                      <p class="mt-0.5 text-xs leading-snug text-white/85">{member.role}</p>
                      {member.memberSince && (
                        <p class="mt-1 text-[11px] leading-snug text-white/65">
                          Member since {member.memberSince}
                        </p>
                      )}

                      {(memberLinks(member.social).length > 0 || member.social?.email) && (
                        <div class="team-reveal">
                          <div class="flex justify-center gap-0.5 pt-2">
                            {memberLinks(member.social).map((link) => (
                              <a
                                href={link.href}
                                class="inline-flex h-9 w-9 items-center justify-center rounded-full text-white/80 transition-colors hover:bg-white/15 hover:text-white"
                                target="_blank"
                                rel="noopener"
                                aria-label={`${member.name} on ${link.label}`}
                              >
                                <SocialIcon network={link.network} class="h-4 w-4" />
                              </a>
                            ))}
                            {member.social?.email && (
                              <a
                                href={`mailto:${member.social.email}`}
                                class="inline-flex h-9 w-9 items-center justify-center rounded-full text-white/80 transition-colors hover:bg-white/15 hover:text-white"
                                aria-label={`Email ${member.name}`}
                              >
                                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">
                                  mail
                                </span>
                              </a>
                            )}
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              ))}

              <a
                href="/join/"
                class="group relative flex aspect-[3/4] flex-col items-center justify-center rounded-xl border-2 border-dashed border-primary-container/60 bg-surface-container-low/60 p-3 text-center transition-colors hover:border-primary-container hover:bg-primary-container/10"
              >
                <span
                  class="material-symbols-outlined mb-1 text-3xl text-primary transition-transform group-hover:scale-110"
                  aria-hidden="true"
                >
                  person_add
                </span>
                <span class="font-display text-sm font-semibold text-on-surface">Join the team</span>
                <span class="mt-1 text-xs text-on-surface-variant">Become an Easterner</span>
              </a>
            </div>

            {team.length > preview && (
              <div class="text-center">
                <button
                  type="button"
                  id="team-show-more"
                  class="btn btn-outline text-sm touch-target"
                  data-team-total={team.length}
                  aria-expanded="false"
                  aria-controls="team-grid"
                >
                  Show all {team.length} members
                </button>
              </div>
            )}
          </>
        ) : (
          <div class="text-center max-w-md mx-auto mb-10">
            <p class="text-on-surface-variant mb-4">Team roster coming soon.</p>
            <a href="/join/" class="btn btn-primary">Join Us</a>
          </div>
        )
      }
    </div>
  </section>

  <section class="bg-primary-container text-on-primary-container py-16">
    <div class="wrap text-center">
      <h2 class="font-display text-headline-lg mb-3">We are Easterners</h2>
      <p class="text-lg mb-6 max-w-xl mx-auto">United to rise and empower the community.</p>
      <a href="/join/" class="btn btn-ink">Become a Rotaractor</a>
    </div>
  </section>

  <section class="section-pad">
    <div class="wrap">
      <p class="label-caps text-center mb-2">Areas of focus</p>
      <h2 class="font-display text-headline-lg text-center mb-10">Where we serve</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          settings.areasOfFocus.map((area) => (
            <article class="bg-surface-container-lowest border border-outline-variant/40 rounded-lg p-6">
              <h3 class="font-display font-semibold text-on-surface mb-2">{area.title}</h3>
              <p class="text-sm text-on-surface-variant">{area.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .team-card {
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .team-card:hover,
  .team-card:focus-within,
  .team-card.is-open {
    transform: translateY(-0.25rem);
    box-shadow: 0 14px 28px -8px rgb(35 26 17 / 0.35);
  }

  .team-plate {
    backdrop-filter: blur(4px);
    transition: background-color 0.3s ease;
  }

  .team-card:hover .team-plate,
  .team-card:focus-within .team-plate,
  .team-card.is-open .team-plate {
    background-color: rgb(17 17 17 / 0.72);
  }

  /* Socials stay collapsed until hover (desktop), keyboard focus, or tap (touch).
     Name, role and "Member since" are always visible. */
  .team-reveal {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.3s ease,
      opacity 0.3s ease;
  }

  .team-card:hover .team-reveal,
  .team-card:focus-within .team-reveal,
  .team-card.is-open .team-reveal {
    max-height: 3.25rem;
    opacity: 1;
  }

  /* Touch has no hover - cards with socials are tappable to open/close. */
  @media (hover: none) {
    .team-card:has(.team-reveal) {
      cursor: pointer;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card,
    .team-plate,
    .team-reveal {
      transition: none;
    }

    .team-card:hover,
    .team-card:focus-within,
    .team-card.is-open {
      transform: none;
    }
  }
</style>

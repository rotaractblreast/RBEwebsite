---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CardPost from "@/components/CardPost.astro";
import { getPosts } from "@/lib/content";
import type { PostTag } from "@/lib/types";

export async function getStaticPaths() {
  const posts = await getPosts();
  const bySlug = new Map<string, PostTag>();
  for (const p of posts) {
    for (const t of p.tags ?? []) {
      if (t?.slug && !bySlug.has(t.slug)) bySlug.set(t.slug, t);
    }
  }
  return [...bySlug.values()].map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      posts: posts.filter((p) => (p.tags ?? []).some((t) => t.slug === tag.slug)),
    },
  }));
}

const { tag, posts } = Astro.props;
const title = `Tag: ${tag.title}`;
---
<BaseLayout
  title={title}
  description={`Explore news stories, service initiatives, and project updates tagged "${tag.title}" from Rotaract Bangalore East.`}
>
  <PageHero title={title} eyebrow="News archive" />
  <Breadcrumbs
    crumbs={[
      { label: "Home", href: "/" },
      { label: "News", href: "/news/" },
      { label: tag.title },
    ]}
  />
  <section class="section-pad">
    <div class="wrap">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => <CardPost post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>

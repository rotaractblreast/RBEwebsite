---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import MarkdownBody from "@/components/MarkdownBody.astro";
import Share from "@/components/Share.astro";
import { getPosts } from "@/lib/content";
import { formatDate } from "@/lib/events";
import { newsCategoryPath } from "@/lib/paths";
import { SITE } from "@/lib/site";
import { breadcrumbListJsonLd, newsArticleJsonLd } from "@/lib/seo";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const parts = new Intl.DateTimeFormat("en-CA", {
      timeZone: "Asia/Kolkata",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).formatToParts(new Date(post.publishedAt));
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? "01";
    return {
      params: {
        year: get("year"),
        month: get("month"),
        day: get("day"),
        slug: post.slug,
      },
      props: {
        post,
        prev: posts[i + 1] ?? null,
        next: posts[i - 1] ?? null,
      },
    };
  });
}

const { post, prev, next } = Astro.props;
const authorName = SITE.title;
const categories = (post.categories ?? []).filter((c) => c?.slug);
const crumbs = [
  { label: "Home", href: "/" },
  { label: "News", href: "/news/" },
  { label: post.title },
];
const fallbackPostSummary = `${post.title} - News story and community project update from Rotaract Bangalore East (Easterners).`;
const postDescription = (post.description || fallbackPostSummary).trim();
const jsonLd = [
  newsArticleJsonLd({
    title: post.title,
    description: postDescription,
    url: post.url,
    publishedAt: post.publishedAt,
    image: post.image,
  }),
  breadcrumbListJsonLd(crumbs),
];
---
<BaseLayout
  title={post.title}
  description={postDescription}
  image={post.image}
  imageAlt={post.title}
  ogType="article"
  publishedTime={post.publishedAt}
  modifiedTime={post.publishedAt}
  canonicalPath={post.url}
  jsonLd={jsonLd}
>
  <PageHero title={post.title} eyebrow="News" hideTitle background={false} />
  <Breadcrumbs crumbs={crumbs} />
  <article class="section-pad pt-0">
    <div class="wrap max-w-3xl">
      {
        post.image && (
          <img
            src={post.image}
            alt={post.title}
            class="w-full rounded-lg mb-8 aspect-[16/9] object-cover"
            fetchpriority="high"
            decoding="async"
            width="1200"
            height="675"
          />
        )
      }
      <p class="text-metadata text-on-surface-variant mb-3">
        {formatDate(post.publishedAt)}
        {authorName ? ` · ${authorName}` : ""}
      </p>
      {
        categories.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-4" aria-label="Categories">
            {categories.map((cat) => (
              <a
                href={newsCategoryPath(cat.slug)}
                class="text-xs uppercase tracking-wider border border-outline-variant/60 text-on-surface px-2.5 py-1 rounded-full font-semibold hover:border-primary hover:text-primary"
              >
                {cat.title}
              </a>
            ))}
          </div>
        )
      }
      <h1 class="font-display text-headline-lg text-on-surface mb-6">{post.title}</h1>
      <MarkdownBody markdown={post.bodyMarkdown} />
      <Share url={post.url} title={post.title} tags={post.tags} />
      <div class="flex justify-between gap-4 mt-10 pt-8 border-t border-outline-variant/40">
        {prev ? <a href={prev.url} class="btn btn-outline text-sm">← Previous</a> : <span />}
        {next ? <a href={next.url} class="btn btn-outline text-sm">Next →</a> : null}
      </div>
    </div>
  </article>
</BaseLayout>

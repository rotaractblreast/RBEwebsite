---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CardPost from "@/components/CardPost.astro";
import { getPosts } from "@/lib/content";
import { postDateParts } from "@/lib/paths";
import type { Post, PostCategory } from "@/lib/types";

type ArchiveKind = "year" | "category";

export async function getStaticPaths() {
  const posts = await getPosts();
  const paths: Array<{
    params: { year: string };
    props: { kind: ArchiveKind; title: string; posts: Post[] };
  }> = [];

  const years = [...new Set(posts.map((p) => postDateParts(p, ["year"]).year))];
  for (const y of years) {
    paths.push({
      params: { year: y },
      props: {
        kind: "year",
        title: y,
        posts: posts.filter((p) => postDateParts(p, ["year"]).year === y),
      },
    });
  }

  const bySlug = new Map<string, PostCategory>();
  for (const p of posts) {
    for (const c of p.categories ?? []) {
      if (c?.slug && !bySlug.has(c.slug)) bySlug.set(c.slug, c);
    }
  }
  for (const cat of bySlug.values()) {
    paths.push({
      params: { year: cat.slug },
      props: {
        kind: "category",
        title: cat.title,
        posts: posts.filter((p) => (p.categories ?? []).some((c) => c.slug === cat.slug)),
      },
    });
  }

  return paths;
}

const { title, posts } = Astro.props;
---
<BaseLayout
  title={`${title} - News`}
  description={`Browse news updates, service milestones, and club activities from ${title} by Rotaract Bangalore East.`}
>
  <PageHero title={title} eyebrow="News archive" />
  <Breadcrumbs
    crumbs={[{ label: "Home", href: "/" }, { label: "News", href: "/news/" }, { label: title }]}
  />
  <section class="section-pad">
    <div class="wrap">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => <CardPost post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>

---
import type { Cause } from "../lib/types";
import { formatInrCurrency } from "../lib/format";
import { urlForCardImage } from "../lib/content";

interface Props {
  cause: Cause;
}
const { cause } = Astro.props;
const cardImage = urlForCardImage(cause.image);
---
<article class="card card-lift group flex flex-col">
  <a href={cause.url} class="block aspect-[16/10] overflow-hidden bg-surface-container">
    {
      cardImage && (
        <img
          src={cardImage}
          alt={cause.title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
          width="750"
          height="420"
        />
      )
    }
  </a>
  <div class="p-5 flex flex-col flex-1">
    <p class="label-caps mb-2">{cause.focus || "Cause"}</p>
    <h3 class="font-display text-lg font-semibold text-on-surface mb-2">
      <a href={cause.url} class="hover:text-primary">{cause.title}</a>
    </h3>
    {
      cause.intro ? (
        <p class="text-sm text-on-surface-variant line-clamp-3 mb-4 flex-1">
          {cause.intro.replace(/<[^>]+>/g, "").slice(0, 120)}
        </p>
      ) : (
        <div class="flex-1" />
      )
    }
    {
      !!cause.progress && (
        <>
          <div
            class="progress mb-2"
            role="progressbar"
            aria-valuenow={cause.progress}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label="Fundraising progress"
          >
            <span style={`width: ${cause.progress}%`} />
          </div>
          <p class="text-xs text-on-surface-variant mb-4">
            {cause.progress}% funded
            {cause.goal != null && Number.isFinite(cause.goal)
              ? ` · Goal ${formatInrCurrency(cause.goal)}`
              : ""}
          </p>
        </>
      )
    }
    <a
      href={cause.url}
      class="text-metadata text-primary font-bold uppercase tracking-wider mt-auto inline-flex items-center gap-1 group-hover:gap-2 transition-all"
    >
      Support cause <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
